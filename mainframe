# ---------------------------------------------------------------------------
# Small 4x4 matrix helpers (column-vector convention, no extra dependencies)
# ---------------------------------------------------------------------------
def perspective(fov_deg, aspect, near, far):
    f = 1.0 / math.tan(math.radians(fov_deg) / 2.0)
    m = np.zeros((4, 4), np.float32)
    m[0, 0], m[1, 1] = f / aspect, f
    m[2, 2] = (far + near) / (near - far)
    m[2, 3] = 2.0 * far * near / (near - far)
    m[3, 2] = -1.0
    return m


def translate(x, y, z):
    m = np.eye(4, dtype=np.float32)
    m[:3, 3] = (x, y, z)
    return m


def scale_m(sx, sy, sz):
    return np.diag([sx, sy, sz, 1.0]).astype(np.float32)


def rot_x(a):
    c, s = math.cos(a), math.sin(a)
    m = np.eye(4, dtype=np.float32)
    m[1, 1], m[1, 2], m[2, 1], m[2, 2] = c, -s, s, c
    return m


def rot_y(a):
    c, s = math.cos(a), math.sin(a)
    m = np.eye(4, dtype=np.float32)
    m[0, 0], m[0, 2], m[2, 0], m[2, 2] = c, s, -s, c
    return m


def unit(v):
    v = np.asarray(v, np.float32)
    n = float(np.linalg.norm(v))
    return v / n if n > 1e-8 else np.array([0, 1, 0], np.float32)


def axis_angle(axis, ang):
    x, y, z = unit(axis)
    c, s = math.cos(ang), math.sin(ang)
    C = 1 - c
    m = np.eye(4, dtype=np.float32)
    m[:3, :3] = [[c + x * x * C, x * y * C - z * s, x * z * C + y * s],
                 [y * x * C + z * s, c + y * y * C, y * z * C - x * s],
                 [z * x * C - y * s, z * y * C + x * s, c + z * z * C]]
    return m


def gl_bytes(m):
    """numpy (row-major) matrix -> bytes in OpenGL's column-major order."""
    return np.ascontiguousarray(m.T, dtype=np.float32).tobytes()


def rot_between(a, b):
    """3x3 rotation taking unit vector a onto unit vector b."""
    a = np.asarray(a, np.float64)
    b = np.asarray(b, np.float64)
    a = a / (np.linalg.norm(a) + 1e-12)
    b = b / (np.linalg.norm(b) + 1e-12)
    c = float(a @ b)
    if c > 1 - 1e-9:
        return np.eye(3)
    if c < -1 + 1e-9:
        axis = np.cross(a, [1.0, 0.0, 0.0])
        if np.linalg.norm(axis) < 1e-6:
            axis = np.cross(a, [0.0, 1.0, 0.0])
        return axis_angle(axis, math.pi)[:3, :3].astype(np.float64)
    v = np.cross(a, b)
    return axis_angle(v, math.atan2(float(np.linalg.norm(v)), c))[:3, :3].astype(np.float64)


def smooth_mesh(mesh, iters=3, lam=0.5):
    """Laplacian smoothing that keeps the overall size."""
    v = np.asarray(mesh.vertices, np.float64).copy()
    e = mesh.edges_unique
    lo0, hi0 = v.min(0), v.max(0)
    for _ in range(iters):
        acc, cnt = np.zeros_like(v), np.zeros(len(v))
        np.add.at(acc, e[:, 0], v[e[:, 1]])
        np.add.at(acc, e[:, 1], v[e[:, 0]])
        np.add.at(cnt, e[:, 0], 1.0)
        np.add.at(cnt, e[:, 1], 1.0)
        v += lam * (acc / np.maximum(cnt, 1.0)[:, None] - v)
    lo1, hi1 = v.min(0), v.max(0)
    v = (v - (lo1 + hi1) / 2) * ((hi0 - lo0) / np.maximum(hi1 - lo1, 1e-9)) + (lo0 + hi0) / 2
    return trimesh.Trimesh(v, mesh.faces, process=False)


