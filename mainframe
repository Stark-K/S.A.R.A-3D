# ---------------------------------------------------------------------------
def build_grid():
    """Floor grid + axes as coloured line segments: [x, y, z, r, g, b, a]."""
    verts = []

    def line(p0, p1, rgb, alpha, fade=True, n=16):
        p0, p1 = np.array(p0, np.float32), np.array(p1, np.float32)
        for i in range(n):
            for k in (i, i + 1):
                pt = p0 + (p1 - p0) * (k / n)
                al = alpha
                if fade:
                    d = math.sqrt(pt[0] ** 2 + FLOOR_Y ** 2 + (CAM_Z - pt[2]) ** 2)
                    al *= clamp(1 - (d - 3) / 16, 0.0, 1.0)
                verts.append((*pt, *rgb, al))

    z0, z1 = Z_MIN - 1, Z_MAX + 0.5
    for xi in range(-8, 9):
        main = xi == 0
        line((xi, FLOOR_Y, z0), (xi, FLOOR_Y, z1),
             (0.3, 0.6, 1.0) if main else (0.1, 0.65, 0.9), 0.55 if main else 0.28)
    for zi in range(int(Z_MIN) - 1, int(Z_MAX) + 2):
        main = zi == 0
        line((-8, FLOOR_Y, zi), (8, FLOOR_Y, zi),
             (0.3, 0.6, 1.0) if main else (0.1, 0.65, 0.9), 0.55 if main else 0.28)
    line((0, FLOOR_Y, 0), (1.6, FLOOR_Y, 0), (1.0, 0.25, 0.25), 0.95, False, 2)    # X red
    line((0, FLOOR_Y, 0), (0, FLOOR_Y + 1.6, 0), (0.3, 1.0, 0.3), 0.95, False, 2)  # Y green
    line((0, FLOOR_Y, 0), (0, FLOOR_Y, 1.6), (0.3, 0.5, 1.0), 0.95, False, 2)      # Z blue
    return np.array(verts, np.float32)


class Renderer:
    def __init__(self, width, height, scale=1.0):
        self.W, self.H = width, height
        self.rw, self.rh = int(width * scale), int(height * scale)
        self.ctx = moderngl.create_standalone_context()
        self.prog = self.ctx.program(vertex_shader=VERT_SHADER, fragment_shader=FRAG_SHADER)
        self.line_prog = self.ctx.program(vertex_shader=LINE_VERT, fragment_shader=LINE_FRAG)
        self.fbo = self.ctx.framebuffer(
            color_attachments=[self.ctx.texture((self.rw, self.rh), 4)],
            depth_attachment=self.ctx.depth_renderbuffer((self.rw, self.rh)))
        self.aspect = width / height
        self.tan_half = math.tan(math.radians(FOV) / 2.0)
        proj = perspective(FOV, self.aspect, 0.1, 50.0)
        proj[1, 1] *= -1.0              # flip Y so the readback is already top-down
        self.vp = proj @ translate(0, 0, -CAM_Z)

        grid = build_grid()
        self.grid_n = len(grid)
        self.grid_vbo = self.ctx.buffer(grid.tobytes())
        self.grid_vao = self.ctx.vertex_array(
            self.line_prog, [(self.grid_vbo, "3f 4f", "in_position", "in_color")])
        self.dyn_vbo = self.ctx.buffer(reserve=512 * 1024)
        self.dyn_vao = self.ctx.vertex_array(
            self.line_prog, [(self.dyn_vbo, "3f 4f", "in_position", "in_color")])
        self.pt_prog = self.ctx.program(vertex_shader=PT_VERT, fragment_shader=PT_FRAG)
        self.pt_vbo = self.ctx.buffer(reserve=MAX_PARTICLES * 5 * 4)
        self.pt_vao = self.ctx.vertex_array(
            self.pt_prog, [(self.pt_vbo, "3f 1f 1f", "in_position", "in_life", "in_size")])

    # Screen <-> world. An object's (x, y) is where it appears on screen; z is its
    # depth. Changing z moves it toward/away from the camera along that same ray.
    def unproject(self, x, y, z=0.0):
        d = CAM_Z - z
        return ((x / self.W * 2 - 1) * d * self.tan_half * self.aspect,
                -(y / self.H * 2 - 1) * d * self.tan_half, z)

    def project(self, wx, wy, wz):
        d = max(CAM_Z - wz, 0.5)
        return ((wx / (d * self.tan_half * self.aspect) + 1) / 2 * self.W,
                (1 - wy / (d * self.tan_half)) / 2 * self.H)

    def px_per_world(self, z=0.0):
        return self.H / (2 * (CAM_Z - z) * self.tan_half)

    def _set_transform(self, M):
        p = self.prog
        p["model"].write(gl_bytes(M))
        p["mvp"].write(gl_bytes(self.vp @ M))
        p["normal_mat"].write(np.ascontiguousarray(np.linalg.inv(M[:3, :3]), np.float32).tobytes())

    def _drop_lines(self, objects):
        rows = []
        for o in objects[:200]:
            wx, wy, wz = self.unproject(o.x, o.y, o.z)
            rgb = (1.0, 0.7, 0.15) if o.selected else (0.2, 0.85, 1.0)
            a = 0.9 if o.selected else 0.55
            rows.append((wx, wy, wz, *rgb, a))
            rows.append((wx, FLOOR_Y, wz, *rgb, a * 0.5))
            r = max(0.2, 0.5 * o.scale * float(max(o.stretch[0], o.stretch[2])))
            for i in range(16):
                for k in (i, i + 1):
                    ang = 2 * math.pi * k / 16
                    rows.append((wx + r * math.cos(ang), FLOOR_Y, wz + r * math.sin(ang), *rgb, a * 0.6))
        return np.array(rows, np.float32)

    def render(self, objects, t, particles=None):
        """Draw the 3D world; returns an RGBA uint8 image (premultiplied alpha)."""
        p = self.prog
        self.fbo.use()
        self.fbo.depth_mask = True                       # required for the depth clear
        self.fbo.clear(0.0, 0.0, 0.0, 0.0)
        self.ctx.enable(moderngl.DEPTH_TEST | moderngl.BLEND)
        p["time"].value = t
        p["cam_pos"].value = (0.0, 0.0, CAM_Z)

        # 1) solid shapes write depth (Z-buffer) so they truly hide what is behind them
        self.ctx.blend_func = moderngl.ONE, moderngl.ONE_MINUS_SRC_ALPHA
        for o in objects:
            if o.style == "solid":
                self._draw_object(o)

        # 2) floor grid, axes, drop-lines: depth-tested against the solids, additive
        self.fbo.depth_mask = False
        self.ctx.blend_func = moderngl.ONE, moderngl.ONE
        lp = self.line_prog
        lp["mvp"].write(gl_bytes(self.vp))
        self.grid_vao.render(moderngl.LINES, vertices=self.grid_n)
        dyn = self._drop_lines(objects)
        if len(dyn):
            self.dyn_vbo.write(dyn.tobytes())
            self.dyn_vao.render(moderngl.LINES, vertices=len(dyn))

        # exhaust particles: glowing additive points, depth-tested against solids
        if particles is not None and len(particles):
            self.ctx.enable(moderngl.DEPTH_TEST | moderngl.BLEND | moderngl.PROGRAM_POINT_SIZE)
            self.pt_vbo.write(particles[:MAX_PARTICLES].tobytes())
            self.pt_prog["vp"].write(gl_bytes(self.vp))
            self.pt_prog["px_scale"].value = self.rh / (2.0 * self.tan_half)
            self.pt_vao.render(moderngl.POINTS, vertices=min(len(particles), MAX_PARTICLES))

        # 3) see-through shapes: depth-tested against solids, blended additively
        for o in objects:
            if o.style != "solid":
                self._draw_object(o)

        raw = self.fbo.read(components=4)
        return np.frombuffer(raw, np.uint8).reshape(self.rh, self.rw, 4)

    def _draw_object(self, o):
        p = self.prog
        base = o.model_matrix(self)
        p["style"].value = STYLE_ID[o.style]
        p["held"].value = 1.0 if o.held else 0.0
        obj_glow = 1.0 if (o.selected and o.focus is None) else 0.0
        on_base = False
        for i, part in enumerate(o.parts):
            sp = part.spinner
            if sp is not None and sp.angle != 0.0:
                self._set_transform(base @ sp.mat)
                on_base = False
            elif not on_base:
                self._set_transform(base)
                on_base = True
            p["u_color"].value = tuple(COLORS[part.color_name])
            p["u_override"].value = 1.0 if part.override else 0.0
            p["selected"].value = obj_glow
            p["focus"].value = 1.0 if (o.selected and o.focus == i) else 0.0
            part.geom.vao.render(moderngl.TRIANGLES)


def composite(bg, gl_rgba, width, height):
    """Blend the premultiplied GL layer over the background (all in OpenCV)."""
    alpha = cv2.extractChannel(gl_rgba, 3)
    if cv2.countNonZero(alpha) == 0:
        return bg
    bgr = cv2.cvtColor(gl_rgba, cv2.COLOR_RGBA2BGR)
    if bgr.shape[1] != width:
        bgr = cv2.resize(bgr, (width, height), interpolation=cv2.INTER_LINEAR)
        alpha = cv2.resize(alpha, (width, height), interpolation=cv2.INTER_LINEAR)
    inv = cv2.cvtColor(cv2.bitwise_not(alpha), cv2.COLOR_GRAY2BGR)
    out = cv2.add(cv2.multiply(bg, inv, scale=1.0 / 255.0), bgr)
    if ENABLE_GLOW:
        small = cv2.resize(bgr, (width // 4, height // 4), interpolation=cv2.INTER_AREA)
        small = cv2.GaussianBlur(small, (0, 0), 5)
        out = cv2.addWeighted(out, 1.0, cv2.resize(small, (width, height), interpolation=cv2.INTER_LINEAR), 0.5, 0)
    return out


