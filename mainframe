def draw_map(img, studio, x0, y0, x1, y1):
    """Top-down view of the 3D world: X across, depth (Z) up/down."""
    panel(img, x0, y0, x1, y1, "3D MAP  (top view)", C_GREEN)
    px0, py0, px1, py1 = x0 + 12, y0 + 42, x1 - 12, y1 - 12
    xr, zr = 5.0, (Z_MIN, Z_MAX + 0.5)

    def to_map(wx, wz):
        return (int(px0 + (wx / xr + 1) / 2 * (px1 - px0)),
                int(py0 + (zr[1] - wz) / (zr[1] - zr[0]) * (py1 - py0)))

    cv2.rectangle(img, (px0, py0), (px1, py1), C_EDGE, 1)
    for gz in range(int(Z_MIN), int(Z_MAX) + 1, 2):
        cv2.line(img, to_map(-xr, gz), to_map(xr, gz), (60, 45, 20), 1)
    for gx in range(-4, 5, 2):
        cv2.line(img, to_map(gx, zr[0]), to_map(gx, zr[1]), (60, 45, 20), 1)
    cam = to_map(0, Z_MAX + 0.4)
    cv2.circle(img, cam, 4, C_WHITE, -1)
    for o in studio.objects:
        wx, _, wz = studio.r.unproject(o.x, o.y, o.z)
        p = to_map(clamp(wx, -xr, xr), wz)
        rad = int(clamp(o.scale * 9, 4, 22))
        col = C_AMBER if o.selected else rgb_to_bgr(o.display_rgb())
        cv2.circle(img, p, rad, col, -1 if o.selected else 2, cv2.LINE_AA)
    put(img, "far", px0 + 4, py0 + 14, C_DIM, 0.36)
    put(img, "you", cam[0] + 8, cam[1] - 4, C_DIM, 0.36)


