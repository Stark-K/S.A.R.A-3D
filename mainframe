SYNONYMS = [{"blade", "fan", "propeller", "prop", "rotor", "turbine", "vane", "impeller", "paddle"},
            {"wheel", "tire", "tyre", "rim"}, {"gear", "cog", "sprocket"},
            {"door", "hatch", "panel"}, {"wing", "flap", "aileron"}]


def _plural(w):
    return w[:-1] if len(w) > 3 and w.endswith("s") else w


def name_tokens(name):
    s = re.sub(r"([a-z])([A-Z])", r"\1 \2", name)
    return {_plural(t) for t in re.findall(r"[a-z]+|\d+", s.lower())}


def match_parts(obj, query):
    q = [_plural(x) for x in query]
    scored = []
    for i, p in enumerate(obj.parts):
        toks, sc = name_tokens(p.name), 0
        for t in q:
            group = next((g for g in SYNONYMS if t in g), {t})
            if any(e in toks or any(len(e) >= 3 and len(x) >= 3 and (e in x or x in e) for x in toks)
                   for e in group):
                sc += 1
        scored.append((sc, i))
    best = max((s for s, _ in scored), default=0)
    return [i for s, i in scored if s == best and s > 0]


def auto_axis(points):
    """Guess a spin axis: disc-like group -> its normal, long group -> its length."""
    q = points - points.mean(0)
    if len(q) > 20000:
        q = q[np.random.choice(len(q), 20000, replace=False)]
    w, v = np.linalg.eigh(np.cov(q.T))
    if w[0] < 0.35 * w[1]:
        return v[:, 0]
    if w[2] > 2.5 * w[1]:
        return v[:, 2]
    return np.array([0, 1, 0], np.float32)


