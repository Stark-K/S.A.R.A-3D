            C_AMBER if obj.focus == i else C_WHITE, 0.4)
    if n > rows:
        put(img, f"showing {vis[0] + 1}-{vis[-1] + 1} of {n}", W - 272, y0 + 52 + 20 * len(vis), C_DIM, 0.36)


