def draw_scan_overlay(img, sc):
    x0, y0, x1, y1 = sc.roi
    col = C_GREEN if sc.state == Scanner.CAPTURE else C_AMBER
    for px, py, dx, dy in ((x0, y0, 1, 1), (x1, y0, -1, 1), (x0, y1, 1, -1), (x1, y1, -1, -1)):
        cv2.line(img, (px, py), (px + dx * 28, py), col, 3, cv2.LINE_AA)
        cv2.line(img, (px, py), (px, py + dy * 28), col, 3, cv2.LINE_AA)
    if sc.mask is not None and sc.mask.any():
        cnts, _ = cv2.findContours(sc.mask, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)
        cv2.drawContours(img, cnts, -1, C_GREEN, 2, cv2.LINE_AA)
    if sc.state == Scanner.CAPTURE and sc.stable > 0:
        cv2.ellipse(img, ((x0 + x1) // 2, y0 - 12), (14, 14), -90, 0, 360 * clamp(sc.stable / SCAN_STABLE, 0, 1),
                    C_GREEN, 3, cv2.LINE_AA)
    put(img, f"3D SCAN  {sc.state}   VIEWS {len(sc.views)}/{SCAN_VIEWS}   (SPACE = capture, ENTER = build now)",
        x0, y0 - 30, col, 0.5)
    put(img, sc.msg, x0, y1 + 24, C_WHITE, 0.55, 1)
    for i, th in enumerate(sc.thumbs):
        xx, yy = x0 + 8 + i * 88, y1 - 90
        img[yy:yy + 80, xx:xx + 80] = th
        cv2.rectangle(img, (xx, yy), (xx + 80, yy + 80), C_GREEN, 1)


