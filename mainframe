def main():
    ensure_model()
    renderer = Renderer(W, H, RENDER_SCALE)
    studio = Studio(renderer)
    cmd_q = queue.Queue()
    voice = VoiceAssistant(cmd_q)
    dialog_state = {}
    studio.speak = voice.speak
    studio.request_file_dialog = lambda: open_file_dialog(cmd_q, dialog_state)
    scan_q = queue.Queue()
    studio.scanner = Scanner(scan_q, voice.speak)
    studio.web = WebOptions(cmd_q, voice.speak)
    print(f"Voice output: {voice.speaker.mode}"
          + ("" if HAS_EDGE else "   (for the human-like voice run: python -m pip install edge-tts)"))
    print("Microphone:", "ready" if HAS_SR else "missing - python -m pip install SpeechRecognition pyaudio")

    tracker = HandTracker()
    tracker.start()
    pinch, backdrop = PinchTracker(), Backdrop(W, H)

    studio.add_shape("cube", "cyan")
    studio.add_shape("pyramid", "amber")
    studio.select(studio.objects[0])
    voice.speak("Sara online. Say Sara, then tell me what to build.")

    win = "S.A.R.A 3D Studio"
    cv2.namedWindow(win, cv2.WINDOW_NORMAL)
    cv2.resizeWindow(win, W, H)

    start = prev = time.time()
    fps, last_id = 30.0, -1
    typing, show_hud, fullscreen = None, True, False
    shape_keys = {ord(str(i + 1)): s for i, s in enumerate(["cube", "pyramid", "cylinder", "sphere", "cone", "torus"])}

    try:
        while True:
            fid, frame, hands = tracker.get(last_id)
            if frame is not None and fid != last_id:
                last_id = fid
                now = time.time()
                dt = clamp(now - prev, 0.001, 0.1)
                prev = now
                fps = 0.92 * fps + 0.08 / dt
                t = now - start

                studio.scanner.update(frame, hands, now)
                while not scan_q.empty():
                    res = scan_q.get_nowait()
                    studio.scanner.state = Scanner.IDLE
                    if res[0] == "ok":
                        studio.add_scanned(res[1], res[2])
                        studio.toast("SCAN COMPLETE", 4)
                        voice.speak("Scan complete. You can paint it, smooth it, resize it, or merge it with other shapes.")
                    else:
                        studio.toast("SCAN FAILED: " + res[1][:60], 6)
                        voice.speak("Sorry, the scan failed. Try again with better light.")
                infos = pinch.update(hands)
                studio.handle_gestures([(h["point"][0], h["point"][1], h["size"]) for h in infos if h["pinching"]])
                while not cmd_q.empty():
                    err = studio.execute(cmd_q.get_nowait())
                    if err:
                        voice.speak(err)
                studio.update(dt)

                out = composite(backdrop.apply(frame, t), renderer.render(studio.objects, t, studio.particles.gpu_array()), W, H)
                if show_hud:
                    draw_object_overlays(out, studio)
                if studio.scanner.active():
                    draw_scan_overlay(out, studio.scanner)
                draw_hands(out, infos)
                if show_hud:
                    draw_hud(out, studio, voice, fps, infos, t, typing)
                    draw_web_panel(out, studio.web)
                cv2.imshow(win, out)

            key = cv2.waitKey(1) & 0xFF
            if key == 255:
                continue
            if typing is not None:
                if key == 13:
                    if typing.strip():
                        voice.submit(typing, require_wake=False)
                    typing = None
                elif key == 27:
                    typing = None
                elif key in (8, 127):
                    typing = typing[:-1]
                elif 32 <= key < 127:
                    typing += chr(key)
                continue
            if key in (27, ord("q")):
                break
            elif key == ord("t"):
                typing = ""
            elif key in (ord("l"), ord("o")):
                studio.request_file_dialog()
            elif key == 9:
                studio.select_by("next")
            elif key == ord("p") and studio.sel:
                studio.select_part({"which": "next"})
            elif key == ord("y"):
                studio.toggle_focus_spin()
            elif key in (ord("k"), 32, 13, ord("g"), ord("e"), ord(","), ord(".")):
                sc = studio.scanner
                if key == ord("k"):
                    cmd = Command("scan_cancel" if sc.active() else "scan")
                elif key == 32:
                    cmd = Command("scan_capture")
                elif key == 13:
                    cmd = Command("scan_finish")
                elif key == ord("g"):
                    cmd = Command("align")
                elif key == ord("e"):
                    eng = studio.sel.engine if studio.sel else None
                    cmd = Command("engine", {"on": not (eng and eng.on)})
                else:
                    cmd = Command("engine_thrust", {"pct": None, "delta": -0.1 if key == ord(",") else 0.1})
                err = studio.execute(cmd)
                if err:
                    studio.toast(err.upper()[:70])
            elif key == ord("m"):
                err = studio.merge_selected()
                studio.toast(err or "MERGED")
            elif key == ord("u"):
                err = studio.split_selected()
                studio.toast(err or "SPLIT")
            elif key == ord("a"):
                studio.auto_merge = not studio.auto_merge
                studio.toast("AUTO-MERGE " + ("ON" if studio.auto_merge else "OFF"))
            elif key == ord("["):
                studio.execute(Command("move", {"axis": "z", "amount": -0.5}))
            elif key == ord("]"):
                studio.execute(Command("move", {"axis": "z", "amount": 0.5}))
            elif key == ord("x"):
                studio.delete_selected()
            elif key == ord("c"):
                studio.cycle_color()
            elif key == ord("v"):
                studio.cycle_style()
            elif key == ord("d"):
                studio.duplicate()
            elif key == ord("s"):
                studio.export_selected()
            elif key == ord("r"):
                studio.execute(Command("reset"))
            elif key in (ord("+"), ord("=")):
                studio.execute(Command("scale", {"factor": 1.15}))
            elif key == ord("-"):
                studio.execute(Command("scale", {"factor": 0.87}))
            elif key == ord("h"):
                show_hud = not show_hud
            elif key == ord("f"):
                fullscreen = not fullscreen
                cv2.setWindowProperty(win, cv2.WND_PROP_FULLSCREEN,
                                      cv2.WINDOW_FULLSCREEN if fullscreen else cv2.WINDOW_NORMAL)
            elif key in shape_keys:
                studio.add_shape(shape_keys[key])
    finally:
        tracker.stop()
        cv2.destroyAllWindows()


if __name__ == "__main__":
    main()
