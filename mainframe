# Voice output: human-like female voice with fallbacks
# ---------------------------------------------------------------------------
class Speaker:
    """
    Speaks in its own thread. Order of preference:
      1. Neural female voice via edge-tts (natural sounding, needs internet)
      2. Windows built-in voice (no install), macOS 'say', or pyttsx3
    Replies are cached, so repeated phrases play instantly.
    """

    def __init__(self):
        self.q = queue.Queue()
        self.busy = False
        self.mute_until = 0.0
        self.error = ""
        self.used = ""
        self.neural_retry_at = 0.0
        self.cache_dir = os.path.join(tempfile.gettempdir(), "sara_voice_cache")
        os.makedirs(self.cache_dir, exist_ok=True)
        if HAS_EDGE:
            self.mode = "NEURAL"
        elif os.name == "nt":
            self.mode = "WINDOWS"
        elif sys.platform == "darwin":
            self.mode = "MAC"
        elif HAS_TTS:
            self.mode = "PYTTSX3"
        else:
            self.mode = "NONE"
        threading.Thread(target=self._worker, daemon=True).start()

    def label(self):
        if self.mode == "NONE":
            return "NONE - pip install edge-tts"
        base = f"{self.used or self.mode}"
        if self.mode == "NEURAL" and not self.used:
            base = f"NEURAL ({VOICE_NAME})"
        return base + (f"  [{self.error}]" if self.error else "")

    def say(self, text):
        if self.mode == "NONE" or not text:
            return
        while self.q.qsize() > 2:
            try:
                self.q.get_nowait()
            except queue.Empty:
                break
        self.q.put(text)

    def _worker(self):
        while True:
            text = self.q.get()
            self.busy = True
            ok = False
            try:
                if self.mode == "NEURAL" and time.time() >= self.neural_retry_at:
                    ok = self._say_neural(text)
                    if ok:
                        self.used = f"NEURAL {VOICE_NAME}"
                    else:
                        self.neural_retry_at = time.time() + 30       # don't wait on a dead network
                if not ok:
                    ok = self._say_offline(text)
                    if ok:
                        self.used = "BUILT-IN VOICE"
            except Exception as exc:
                self.error = f"{type(exc).__name__}: {exc}"[:70]
            self.busy = False
            self.mute_until = time.time() + 0.5

    # -- neural voice ------------------------------------------------------------
    async def _synth(self, text, path):
        await edge_tts.Communicate(text, VOICE_NAME, rate=VOICE_RATE, pitch=VOICE_PITCH).save(path)

    def _say_neural(self, text):
        try:
            key = hashlib.sha1(f"{VOICE_NAME}|{VOICE_RATE}|{VOICE_PITCH}|{text}".encode()).hexdigest()[:20]
            path = os.path.join(self.cache_dir, key + ".mp3")
            if not os.path.exists(path):
                tmp = path + ".part"
                asyncio.run(self._synth(text, tmp))
                os.replace(tmp, path)
            self._play_file(path)
            self.error = ""
            return True
        except Exception as exc:
            self.error = f"neural: {type(exc).__name__}"[:40]
            return False

    def _play_file(self, path):
        if os.name == "nt":
            import ctypes
            winmm = ctypes.windll.winmm

            def mci(cmd):
                buf = ctypes.create_unicode_buffer(256)
                err = winmm.mciSendStringW(cmd, buf, 255, 0)
                if err:
                    eb = ctypes.create_unicode_buffer(256)
                    winmm.mciGetErrorStringW(err, eb, 255)
                    raise RuntimeError("MCI " + eb.value)
            mci(f'open "{path}" type mpegvideo alias saravoice')
            try:
                mci("play saravoice wait")
            finally:
                mci("close saravoice")
            return
        for cmd in (["afplay", path], ["mpg123", "-q", path], ["ffplay", "-nodisp", "-autoexit", "-loglevel", "quiet", path]):
            if shutil.which(cmd[0]):
                subprocess.run(cmd, check=True, timeout=60)
                return
        raise RuntimeError("no mp3 player found")

    # -- offline fallbacks -------------------------------------------------------
    def _say_offline(self, text):
        try:
            if os.name == "nt":
                script = ("Add-Type -AssemblyName System.Speech;"
                          "$s = New-Object System.Speech.Synthesis.SpeechSynthesizer;"
                          "try { $s.SelectVoiceByHints([System.Speech.Synthesis.VoiceGender]::Female) } catch {};"
                          "$s.Rate = 0; $s.Speak($env:SARA_TEXT)")
                subprocess.run(["powershell", "-NoProfile", "-NonInteractive", "-Command", script],
                               env=dict(os.environ, SARA_TEXT=text), timeout=40, check=True,
                               capture_output=True, creationflags=getattr(subprocess, "CREATE_NO_WINDOW", 0))
                return True
            if sys.platform == "darwin":
                subprocess.run(["say", "-v", "Samantha", text], timeout=40, check=True)
                return True
            if HAS_TTS:
                engine = pyttsx3.init()
                voices = engine.getProperty("voices")
                for v in voices:
                    if any(k in v.name.lower() for k in ("zira", "female", "hazel", "susan", "samantha")):
                        engine.setProperty("voice", v.id)
                        break
                engine.say(text)
                engine.runAndWait()
                engine.stop()
                return True
        except Exception as exc:
            self.error = f"offline: {type(exc).__name__}"[:40]
        return False


class VoiceAssistant:
    def __init__(self, cmd_queue):
        self.cmd_queue = cmd_queue
        self.speaker = Speaker()
        self.awake_until = 0.0
        self.heard = self.reply = ""
        self.status = "MIC OFFLINE - pip install SpeechRecognition pyaudio" if not HAS_SR else "STARTING MIC..."
        if HAS_SR:
            threading.Thread(target=self._listen_loop, daemon=True).start()

    @property
    def awake(self):
        return time.time() < self.awake_until

    @property
    def is_speaking(self):
        return self.speaker.busy

    def speak(self, text):
        self.reply = text
        self.speaker.say(text)

    def submit(self, text, require_wake):
        """Handle a spoken or typed sentence."""
        found, rest = strip_wake_word(text)
        if require_wake and not found and not self.awake:
            return
        if found and not rest:
            self.awake_until = time.time() + WAKE_WINDOW
            self.speak("Yes, I'm listening.")
            return
        self.awake_until = 0.0
        cmds = parse_commands(text)
        if not cmds:
            self.speak("Sorry, I didn't understand that.")
            return
        self.speak(acknowledgement(cmds))
        for c in cmds:
            self.cmd_queue.put(c)

    def _listen_loop(self):
        rec = sr.Recognizer()
        rec.dynamic_energy_threshold = True
        rec.pause_threshold = 0.7
        try:
            mic = sr.Microphone()
            with mic as source:
                rec.adjust_for_ambient_noise(source, duration=0.8)
        except Exception:
            self.status = "MIC UNAVAILABLE"
            return
        self.status = "SAY 'SARA' TO WAKE"
        while True:
            if self.speaker.busy or time.time() < self.speaker.mute_until:
                time.sleep(0.1)
                continue
            try:
                with mic as source:
                    audio = rec.listen(source, timeout=3, phrase_time_limit=6)
                text = rec.recognize_google(audio, language=STT_LANGUAGE)
            except (sr.WaitTimeoutError, sr.UnknownValueError):
                continue
            except sr.RequestError:
                self.status = "SPEECH SERVICE NEEDS INTERNET"
                time.sleep(2)
                continue
            except Exception:
                time.sleep(0.5)
                continue
            self.status = "SAY 'SARA' TO WAKE"
            self.heard = text.lower()
            self.submit(text, require_wake=True)


