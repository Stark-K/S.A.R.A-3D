class Engine:
    """State of a running engine attached to an object (axis + exhaust end in local space)."""

    def __init__(self, ends, axis, sign, radius):
        self.ends = (np.asarray(ends[0], np.float32), np.asarray(ends[1], np.float32))
        self.axis = unit(axis)
        self.sign = sign                     # +1: exhaust leaves through the far end
        self.radius = float(radius)
        self.on, self.thrust, self.rpm, self.acc = False, 0.6, 0.0, 0.0

    @property
    def nozzle(self):
        return self.ends[1] if self.sign > 0 else self.ends[0]

    @property
    def direction(self):
        return self.axis * self.sign


class ParticleSystem:
    """CPU-simulated exhaust particles in world space, drawn as glowing GPU points."""

    def __init__(self, n=MAX_PARTICLES):
        self.pos = np.zeros((n, 3), np.float32)
        self.vel = np.zeros((n, 3), np.float32)
        self.age = np.ones(n, np.float32)
        self.life = np.full(n, 0.5, np.float32)
        self.size = np.zeros(n, np.float32)
        self.rng = np.random.default_rng(7)

    def emit(self, origin, direction, k, speed, spread, life, size, radius):
        free = np.flatnonzero(self.age >= self.life)[:k]
        k = len(free)
        if k == 0:
            return
        d = unit(direction).astype(np.float64)
        a = np.cross(d, [0.0, 1.0, 0.0])
        if np.linalg.norm(a) < 1e-3:
            a = np.cross(d, [1.0, 0.0, 0.0])
        a /= np.linalg.norm(a)
        b = np.cross(d, a)
        r = self.rng
        ang = r.uniform(0, 2 * np.pi, k)
        lateral = np.cos(ang)[:, None] * a + np.sin(ang)[:, None] * b
        rad = np.sqrt(r.uniform(0, 1, k)) * radius
        self.pos[free] = origin + lateral * rad[:, None]
        cone = lateral * (r.uniform(0, 1, k) * spread)[:, None]
        self.vel[free] = (d + cone) * (speed * r.uniform(0.75, 1.15, k))[:, None]
        self.age[free] = 0.0
        self.life[free] = life * r.uniform(0.7, 1.2, k)
        self.size[free] = size * r.uniform(0.7, 1.3, k)

    def update(self, dt):
        alive = self.age < self.life
        n = int(alive.sum())
        if n == 0:
            return
        self.pos[alive] += self.vel[alive] * dt
        self.vel[alive] *= (1.0 - 0.6 * dt)
        self.vel[alive] += self.rng.standard_normal((n, 3)).astype(np.float32) * (0.6 * dt)
        self.age[alive] += dt

    def gpu_array(self):
        alive = self.age < self.life
        if not alive.any():
            return None
        f = self.age[alive] / self.life[alive]
        return np.column_stack([self.pos[alive], f, self.size[alive] * (1.0 + 1.5 * f)]).astype(np.float32)


def build_engine_parts():
    """Procedural turbofan with named parts (Nacelle, Core, Spinner, Fan_Blade_n, Nozzle, Tail_Cone).
    Axis along X, intake on the left, exhaust on the right.
    Returns (parts [(name, mesh, face_colours)], intake point, exhaust point, exhaust radius)."""
    c, T = trimesh.creation, trimesh.transformations
    parts = []

    def add(name, mesh, rgb):
        parts.append([name, mesh, np.array(rgb, np.float32)])

    def at_z(mesh, z):
        mesh.apply_translation([0, 0, z])
        return mesh

    add("Nacelle", c.annulus(r_min=0.50, r_max=0.60, height=1.0, sections=64), (0.62, 0.68, 0.78))
    add("Core", at_z(c.cylinder(radius=0.27, height=0.62, sections=48), -0.20), (0.30, 0.32, 0.38))
    nose = at_z(c.cone(radius=0.17, height=0.32, sections=32), 0.42)
    hub = at_z(c.cylinder(radius=0.17, height=0.14, sections=32), 0.35)
    add("Spinner", trimesh.util.concatenate([nose, hub]), (0.92, 0.94, 0.98))
    blades = 14
    for i in range(blades):
        blade = c.box(extents=(0.36, 0.11, 0.028))
        blade.apply_transform(T.rotation_matrix(math.radians(28), [1, 0, 0]))
        blade.apply_translation([0.35, 0, 0.35])
        blade.apply_transform(T.rotation_matrix(2 * math.pi * i / blades, [0, 0, 1]))
        add(f"Fan_Blade_{i + 1}", blade, (0.80, 0.84, 0.90))
    add("Nozzle", at_z(c.annulus(r_min=0.22, r_max=0.36, height=0.34, sections=48), -0.62), (0.85, 0.52, 0.25))
    tail = c.cone(radius=0.22, height=0.40, sections=32)
    tail.apply_transform(T.rotation_matrix(math.pi, [1, 0, 0]))
    add("Tail_Cone", at_z(tail, -0.50), (0.35, 0.36, 0.42))
    R = T.rotation_matrix(-math.pi / 2, [0, 1, 0])          # +Z intake -> -X (left)
    for p in parts:
        p[1].apply_transform(R)
    allv = np.vstack([p[1].vertices for p in parts])
    lo, hi = allv.min(0), allv.max(0)
    centre, size = (lo + hi) / 2, float((hi - lo).max())
    out = []
    for name, mesh, rgb in parts:
        mesh.apply_translation(-centre)
        mesh.apply_scale(1.0 / size)
        out.append((name, mesh, np.tile(rgb, (len(mesh.faces), 1))))
    lo_x, hi_x = float((lo[0] - centre[0]) / size), float((hi[0] - centre[0]) / size)
    return out, np.array([lo_x, 0, 0], np.float32), np.array([hi_x, 0, 0], np.float32), 0.30 / size


# ---------------------------------------------------------------------------
# 3D scanning: hold an object in your hand, turn it, get a 3D model
# ---------------------------------------------------------------------------
def _roi_px():
    x0, y0, x1, y1 = SCAN_ROI
    return int(x0 * W), int(y0 * H), int(x1 * W), int(y1 * H)


def segment_object(frame, bg, hand_pts):
    """Binary mask (uint8 0/255, full frame) of the object in the hand.
    Background subtraction, minus skin (colour learned from your palm), minus wrist and arm."""
    x0, y0, x1, y1 = _roi_px()
    f = cv2.GaussianBlur(frame[y0:y1, x0:x1], (5, 5), 0)
    b = cv2.GaussianBlur(bg[y0:y1, x0:x1], (5, 5), 0)
    fg = (cv2.absdiff(f, b).max(axis=2) > SCAN_DIFF).astype(np.uint8) * 255
    out = np.zeros(frame.shape[:2], np.uint8)
    palm, size = None, 1.0
    if hand_pts is not None:
        pts = np.asarray(hand_pts, np.float32)
        size = float(np.linalg.norm(pts[9] - pts[0])) + 1e-3
        palm = pts[[0, 5, 9, 13, 17]].mean(0)
        ycc = cv2.cvtColor(frame, cv2.COLOR_BGR2YCrCb)
        r = int(max(4, 0.1 * size))
        samples = []
        for i in (0, 1, 5, 17):                      # wrist-side palm points
            px, py = int(pts[i][0]), int(pts[i][1])
            patch = ycc[max(py - r, 0):py + r, max(px - r, 0):px + r, 1:3].reshape(-1, 2)
            if len(patch):
                samples.append(patch)
        if samples:
            crcb = np.vstack(samples).astype(np.float32)
            mu = np.median(crcb, axis=0)
            sig = np.maximum(1.4826 * np.median(np.abs(crcb - mu), axis=0), 3.0)
            roi = ycc[y0:y1, x0:x1, 1:3].astype(np.float32)
            skin = np.all(np.abs(roi - mu) < 3.5 * sig + 4.0, axis=2).astype(np.uint8) * 255
            skin = cv2.dilate(skin, np.ones((5, 5), np.uint8))
            fg = cv2.bitwise_and(fg, cv2.bitwise_not(skin))
        ys, xs = np.mgrid[y0:y1, x0:x1].astype(np.float32)
        fwd = pts[9] - pts[0]
        fwd /= np.linalg.norm(fwd) + 1e-6
        fg[((xs - pts[0][0]) * fwd[0] + (ys - pts[0][1]) * fwd[1]) < -0.15 * size] = 0   # forearm / sleeve
    fg = cv2.morphologyEx(fg, cv2.MORPH_OPEN, np.ones((5, 5), np.uint8))
    fg = cv2.morphologyEx(fg, cv2.MORPH_CLOSE, np.ones((9, 9), np.uint8))
    n, lab, stats, cent = cv2.connectedComponentsWithStats(fg)
    best, best_area = 0, 0
    for i in range(1, n):
        area = int(stats[i, cv2.CC_STAT_AREA])
        if palm is not None and math.hypot(cent[i][0] + x0 - palm[0], cent[i][1] + y0 - palm[1]) > 3.2 * size:
            continue
        if area > best_area:
            best, best_area = i, area
    if best == 0 or best_area < 0.01 * fg.size:
        return out
    comp = (lab == best).astype(np.uint8) * 255
    cnts, _ = cv2.findContours(comp, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)
    filled = np.zeros_like(comp)
    cv2.drawContours(filled, cnts, -1, 255, -1)      # fill holes
    out[y0:y1, x0:x1] = filled
    return out


def _fill_colors(img, mask):
    """Push object colours outward so edge pixels never sample the background."""
    inner = (cv2.erode(mask, np.ones((5, 5), np.uint8)) > 0).astype(np.float32)
    num = cv2.GaussianBlur(img.astype(np.float32) * inner[..., None], (0, 0), 5)
    den = cv2.GaussianBlur(inner, (0, 0), 5)
    filled = num / np.maximum(den, 1e-3)[..., None]
    return np.where(inner[..., None] > 0, img.astype(np.float32), filled).astype(np.uint8)


def build_scan_model(views, grid=SCAN_GRID, turn=1.0):
    """views: [(mask, image)] captured every 360/N degrees (un-mirrored camera images).
    One view is inflated into a rounded solid; two or more are carved (visual hull).
    Returns (normalised mesh, per-face RGB colours)."""
    try:
        from scipy import ndimage as ndi
        from skimage import measure
    except ImportError:
        raise RuntimeError("scanning needs: python -m pip install scipy scikit-image")
    G = grid
    boxes = []
    for mask, _ in views:
        ys, xs = np.nonzero(mask)
        if len(xs) < 50:
            raise ValueError("a captured view was empty")
        boxes.append((xs.min(), xs.max() + 1, ys.min(), ys.max() + 1))
    s = 0.86 * G / max(max(b[1] - b[0], b[3] - b[2]) for b in boxes)
    masks, colors = [], []
    for (mask, img), (bx0, bx1, by0, by1) in zip(views, boxes):
        M = np.array([[s, 0, G / 2 - s * (bx0 + bx1) / 2], [0, s, G / 2 - s * (by0 + by1) / 2]], np.float32)
        masks.append(cv2.warpAffine(mask, M, (G, G), flags=cv2.INTER_LINEAR) > 127)
        colors.append(cv2.warpAffine(_fill_colors(img, mask), M, (G, G), flags=cv2.INTER_LINEAR))

    idx = np.arange(G)
    X = idx - G / 2 + 0.5
    rows = G - 1 - idx
    if len(masks) == 1:
        angles = [0.0]
        dt = cv2.distanceTransform(masks[0].astype(np.uint8), cv2.DIST_L2, 5)
        dmax = max(float(dt.max()), 1.0)
        thick = 0.6 * dmax * np.sqrt(np.clip(1 - (1 - dt / dmax) ** 2, 0, 1))
        vol = np.abs(X)[None, None, :] < thick[rows[None, :], idx[:, None]][:, :, None]
    else:
        angles = [turn * 2 * math.pi * k / len(masks) for k in range(len(masks))]
        vol = np.ones((G, G, G), bool)
        for phi, m in zip(angles, masks):
            u = np.rint(X[:, None] * math.cos(phi) + X[None, :] * math.sin(phi) + G / 2 - 0.5).astype(int)
            ok = (u >= 0) & (u < G)
            vol &= m[rows[None, :, None], np.clip(u, 0, G - 1)[:, None, :]] & ok[:, None, :]
    if not vol.any():
        raise ValueError("the views do not overlap; keep the object centred and turn it about its vertical axis")
    lab, n = ndi.label(vol)
    if n > 1:
        vol = lab == 1 + int(np.argmax(ndi.sum(vol, lab, range(1, n + 1))))
    volf = ndi.gaussian_filter(np.pad(vol.astype(np.float32), 2), 1.0)
    verts, faces, _, _ = measure.marching_cubes(volf, level=0.5)
    verts = verts - 2 - G / 2 + 0.5
    v0, v1, v2 = verts[faces[:, 0]], verts[faces[:, 1]], verts[faces[:, 2]]
    if float(np.einsum("ij,ij->i", v0, np.cross(v1, v2)).sum()) < 0:
        faces = faces[:, ::-1]
    mesh = trimesh.Trimesh(verts, faces, process=False)

    cent, nrm = mesh.triangles_center, mesh.face_normals
    best = np.zeros(len(faces), int)
    score = np.full(len(faces), -9.0)
    for k, phi in enumerate(angles):
        w = nrm @ np.array([-math.sin(phi), 0.0, math.cos(phi)])
        better = w > score
        best[better], score[better] = k, w[better]
    rgb = np.zeros((len(faces), 3), np.float32)
    for k, phi in enumerate(angles):
        sel = best == k
        if not sel.any():
            continue
        c = cent[sel]
        u = np.clip(np.rint(c[:, 0] * math.cos(phi) + c[:, 2] * math.sin(phi) + G / 2 - 0.5).astype(int), 0, G - 1)
        v = np.clip(np.rint(G - 1 - (c[:, 1] + G / 2 - 0.5)).astype(int), 0, G - 1)
        rgb[sel] = colors[k][v, u][:, ::-1] / 255.0
    return normalized(mesh), rgb


class Scanner:
    """Hold an object in your hand, turn it in front of the camera, get a 3D model."""
    IDLE, BG, CAPTURE, BUILD = "IDLE", "BACKGROUND", "CAPTURE", "BUILDING"

    def __init__(self, results, say):
        self.results, self.say = results, say
        self.state = self.IDLE
        self.views, self.thumbs = [], []
        self.mask, self.msg = None, ""
        self.roi = _roi_px()
        self._runtime()

    def _runtime(self):
        self.bg = self.bg_acc = self.frame = None
        self.bg_n = 0
        self.stable, self.travel = 0.0, 1e9
        self.last_c = self.last_area = self.last_palm = self.t_prev = None

    def active(self):
        return self.state != self.IDLE

    def start(self):
        if self.state == self.BUILD:
            return "I'm still building the last scan."
        self.views, self.thumbs, self.mask = [], [], None
        self._runtime()
        self.state, self.msg = self.BG, "Take your hand out of view..."
        self.say("Scanner ready. Take your hand out of view for a moment.")
        return None

    def cancel(self):
        if not self.active():
            return "There is no scan running."
        self.state, self.views, self.thumbs, self.mask, self.msg = self.IDLE, [], [], None, ""
        return None

    def capture_now(self):
        if self.state != self.CAPTURE:
            return "Start a scan first."
        if self.mask is None or not self.mask.any():
            return "I can't see the object yet."
        self._store()
        return None

    def finish(self):
        if self.state != self.CAPTURE or not self.views:
            return "Capture at least one view first."
        self._begin_build()
        return None

    def update(self, frame, hands, now):
        if self.state not in (self.BG, self.CAPTURE):
            return
        dt = 0.033 if self.t_prev is None else min(now - self.t_prev, 0.2)
        self.t_prev, self.frame = now, frame
        pts = hands[0][1] if hands else None
        if self.state == self.BG:
            if pts is not None:
                self.bg_acc, self.bg_n = None, 0
                self.msg = "Take your hand out of view..."
                return
            f = frame.astype(np.float32)
            self.bg_acc = f if self.bg_acc is None else self.bg_acc + f
            self.bg_n += 1
            self.msg = f"Learning the background {self.bg_n}/{SCAN_BG_FRAMES}"
            if self.bg_n >= SCAN_BG_FRAMES:
                self.bg = (self.bg_acc / self.bg_n).astype(np.uint8)
                self.state, self.msg = self.CAPTURE, "Hold the object in your hand inside the box"
                self.say("Now hold the object in your hand, inside the box, and keep it still.")
            return
        self.mask = segment_object(frame, self.bg, pts) if pts is not None else None
        area = int(np.count_nonzero(self.mask)) if self.mask is not None else 0
        x0, y0, x1, y1 = self.roi
        ok = pts is not None and area > 0.012 * (x1 - x0) * (y1 - y0)
        palm = pts[9] if pts is not None else None
        if palm is not None and self.last_palm is not None:
            self.travel += float(np.linalg.norm(palm - self.last_palm))
        self.last_palm = palm
        if ok:
            m = cv2.moments(self.mask, True)
            c = (m["m10"] / max(m["m00"], 1e-6), m["m01"] / max(m["m00"], 1e-6))
            steady = (self.last_c is not None and math.hypot(c[0] - self.last_c[0], c[1] - self.last_c[1]) < 8
                      and abs(area - self.last_area) < 0.12 * max(self.last_area, 1))
            self.last_c, self.last_area = c, area
            self.stable = self.stable + dt if steady else 0.0
        else:
            self.stable, self.last_c = 0.0, None
        armed = self.travel > SCAN_MIN_TRAVEL
        n = len(self.views)
        self.msg = (f"View {n + 1}/{SCAN_VIEWS}: " + ("hold it still" if armed else
                    "turn the object 90 degrees to your left")) if ok else "Hold the object in your hand inside the box"
        if ok and armed and self.stable >= SCAN_STABLE:
            self._store()

    def _store(self):
        mask, frame = self.mask.copy(), self.frame.copy()
        self.views.append((mask, frame))
        ys, xs = np.nonzero(mask)
        crop = cv2.bitwise_and(frame, frame, mask=mask)[ys.min():ys.max() + 1, xs.min():xs.max() + 1]
        k = 80.0 / max(crop.shape[:2])
        th = cv2.resize(crop, (max(1, int(crop.shape[1] * k)), max(1, int(crop.shape[0] * k))))
        canvas = np.zeros((80, 80, 3), np.uint8)
        canvas[:th.shape[0], :th.shape[1]] = th
        self.thumbs.append(canvas)
        self.travel, self.stable = 0.0, 0.0
        n = len(self.views)
        if n >= SCAN_VIEWS:
            self._begin_build()
        else:
            self.say(f"Captured view {n}. Turn the object ninety degrees to your left.")

    def _begin_build(self):
        self.state, self.msg = self.BUILD, "Building the 3D model..."
        self.say("Building your model. This takes a few seconds.")
        views = [(cv2.flip(m, 1), cv2.flip(f, 1)) for m, f in self.views]      # undo the mirror view

        def work():
            try:
                mesh, colors = build_scan_model(views, SCAN_GRID, SCAN_TURN)
                self.results.put(("ok", mesh, colors))
            except Exception as exc:
                self.results.put(("err", f"{type(exc).__name__}: {exc}"))
        threading.Thread(target=work, daemon=True).start()


# ---------------------------------------------------------------------------
# Online options: 3D models (Sketchfab) and explanations (Wikipedia)
# ---------------------------------------------------------------------------
def _http_get(url, headers=None, timeout=WEB_TIMEOUT):
    req = urllib.request.Request(url, headers={"User-Agent": "SARA3D/1.0", **(headers or {})})
    with urllib.request.urlopen(req, timeout=timeout) as resp:
        return resp.read()


def search_sketchfab(query, n=MAX_OPTIONS):
    url = "https://api.sketchfab.com/v3/search?" + urllib.parse.urlencode(
        {"type": "models", "q": query, "count": n, "downloadable": "true"})
    out = []
    for m in json.loads(_http_get(url).decode("utf-8")).get("results", []):
        thumbs = (m.get("thumbnails") or {}).get("images") or []
        thumb = min(thumbs, key=lambda t: abs(t.get("width", 0) - 256))["url"] if thumbs else None
        out.append({"source": "3D", "title": m.get("name", "3D model"), "uid": m.get("uid"),
                    "sub": f"{(m.get('user') or {}).get('displayName', '')}  likes {m.get('likeCount', 0)}",
                    "thumb": thumb, "url": m.get("viewerUrl") or f"https://sketchfab.com/models/{m.get('uid')}"})
    return out


def search_wikipedia(query, n=4):
    params = {"action": "query", "generator": "search", "gsrsearch": query, "gsrlimit": n,
              "prop": "pageimages|extracts", "piprop": "thumbnail", "pithumbsize": 300, "exintro": 1,
              "explaintext": 1, "exsentences": 2, "format": "json", "formatversion": 2}
    data = json.loads(_http_get("https://en.wikipedia.org/w/api.php?" + urllib.parse.urlencode(params)).decode("utf-8"))
    pages = sorted(data.get("query", {}).get("pages", []), key=lambda p: p.get("index", 99))
    return [{"source": "INFO", "title": p["title"], "sub": (p.get("extract") or "")[:120],
             "text": p.get("extract") or p["title"], "thumb": (p.get("thumbnail") or {}).get("source"),
             "url": "https://en.wikipedia.org/wiki/" + urllib.parse.quote(p["title"].replace(" ", "_"))}
            for p in pages]


def download_sketchfab(uid, token):
    """Download a model (needs a free Sketchfab API token). Returns a .glb/.gltf path."""
    info = json.loads(_http_get(f"https://api.sketchfab.com/v3/models/{uid}/download",
                                {"Authorization": f"Token {token}"}).decode("utf-8"))
    entry = info.get("glb") or info.get("gltf")
    data = _http_get(entry["url"], timeout=90)
    folder = os.path.join(tempfile.gettempdir(), "sara_downloads", uid)
    os.makedirs(folder, exist_ok=True)
    if info.get("glb"):
        path = os.path.join(folder, "model.glb")
        with open(path, "wb") as fh:
            fh.write(data)
        return path
    zpath = os.path.join(folder, "model.zip")
    with open(zpath, "wb") as fh:
        fh.write(data)
    with zipfile.ZipFile(zpath) as z:
        z.extractall(folder)
    for root, _, files in os.walk(folder):
        for name in files:
            if name.lower().endswith((".gltf", ".glb")):
                return os.path.join(root, name)
    raise RuntimeError("no glTF file in the download")


class WebOptions:
    """Shows online options on screen; 'select option N' loads it or reads it out."""

    def __init__(self, cmd_queue, say):
        self.cmd_queue, self.say = cmd_queue, say
        self.results, self.query, self.status = [], "", ""
        self.visible = self.busy = False

    def search(self, query):
        if self.busy:
            return "I'm still searching."
        self.query, self.status, self.visible, self.results = query, "SEARCHING...", True, []
        threading.Thread(target=self._run, args=(query,), daemon=True).start()
        return None

    def _run(self, query):
        self.busy = True
        found, errors = [], []
        for fn in (search_sketchfab, search_wikipedia):
            try:
                found += fn(query)
            except Exception as exc:
                errors.append(f"{fn.__name__.split('_')[1]}: {type(exc).__name__}")
        self.results = found[:MAX_OPTIONS]
        self.status = f"{len(self.results)} OPTIONS" + (f"  [{'; '.join(errors)}]" if errors else "")
        if self.results:
            self.say(f"I found {len(self.results)} options for {query}. Say select option one, "
                     "or open option two to see it in your browser.")
        else:
            self.say(f"I couldn't find anything online for {query}. Check your internet connection.")
        self.busy = False
        for r in self.results:
            try:
                img = cv2.imdecode(np.frombuffer(_http_get(r["thumb"]), np.uint8), cv2.IMREAD_COLOR)
                h, w = img.shape[:2]
                k = max(96 / w, 72 / h)
                img = cv2.resize(img, (int(w * k) + 1, int(h * k) + 1))
                y0, x0 = (img.shape[0] - 72) // 2, (img.shape[1] - 96) // 2
                r["img"] = img[y0:y0 + 72, x0:x0 + 96].copy()
            except Exception:
                pass

    def pick(self, index, action=None):
        if not self.results:
            return "There are no options on screen. Say: show me options on something."
        if not 1 <= index <= len(self.results):
            return f"There is no option {index}."
        r = self.results[index - 1]
        can_load = r["source"] == "3D" and SKETCHFAB_TOKEN and r.get("uid")
        if action == "open" or (r["source"] == "3D" and not can_load):
            webbrowser.open(r["url"])
            self.say(f"Opening {r['title']} in your browser."
                     + (" Set a Sketchfab token to load models here." if r["source"] == "3D" and not can_load else ""))
        elif can_load:
            self.say(f"Downloading {r['title']}.")
            threading.Thread(target=self._download, args=(r,), daemon=True).start()
        else:
            self.say(r.get("text") or r["title"])
        return None

    def _download(self, r):
        try:
            self.cmd_queue.put(Command("load_path", {"path": download_sketchfab(r["uid"], SKETCHFAB_TOKEN)}))
        except Exception:
            self.say("Sorry, the download failed.")


