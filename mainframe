def dashed_line(img, p1, p2, color, dash=10):
    length = math.hypot(p2[0] - p1[0], p2[1] - p1[1])
    for i in range(0, int(length), dash * 2):
        a, b = i / max(length, 1), min(i + dash, length) / max(length, 1)
        cv2.line(img, (int(p1[0] + (p2[0] - p1[0]) * a), int(p1[1] + (p2[1] - p1[1]) * a)),
                 (int(p1[0] + (p2[0] - p1[0]) * b), int(p1[1] + (p2[1] - p1[1]) * b)), color, 1, cv2.LINE_AA)


def draw_object_overlays(img, studio):
    sel = studio.sel
    if sel is None:
        return
    r = int(sel.radius_px(studio.r))
    cx, cy = int(sel.x), int(sel.y)
    col = C_GREEN if sel.held else C_CYAN
    ln = max(14, r // 4)
    for sx, sy in ((-1, -1), (1, -1), (-1, 1), (1, 1)):
        px, py = cx + sx * r, cy + sy * r
        cv2.line(img, (px, py), (px - sx * ln, py), col, 2, cv2.LINE_AA)
        cv2.line(img, (px, py), (px, py - sy * ln), col, 2, cv2.LINE_AA)
    put(img, f"{sel.name}  {int(sel.scale * 100)}%  Z{sel.z:+.1f}  {sel.style.upper()}",
        clamp(cx - r, 8, W - 330), max(20, cy - r - 10), col, 0.45)
    e = sel.engine
    if e:
        bx, by = int(clamp(cx - r, 8, W - 330)), max(20, cy - r - 10) + 20
        ecol = C_AMBER if e.on else C_DIM
        put(img, f"ENGINE {'ON' if e.on else 'OFF'}   THRUST {int(round(e.thrust * 100))}%   RPM {int(e.rpm * 100)}%",
            bx, by, ecol, 0.45)
        cv2.rectangle(img, (bx, by + 6), (bx + 170, by + 14), C_EDGE, 1)
        cv2.rectangle(img, (bx, by + 6), (bx + int(170 * e.thrust), by + 14), ecol, -1)
    cand = studio.merge_candidate
    if cand is not None:                                     # live merge preview while dragging
        cr = int(cand.radius_px(studio.r))
        cv2.circle(img, (int(cand.x), int(cand.y)), cr, C_AMBER, 2, cv2.LINE_AA)
        dashed_line(img, (sel.x, sel.y), (cand.x, cand.y), C_AMBER)
        put(img, "RELEASE TO SNAP + MERGE", (sel.x + cand.x) / 2 - 90, (sel.y + cand.y) / 2 - 12, C_AMBER, 0.5, 2)


