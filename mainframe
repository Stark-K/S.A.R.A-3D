def strip_wake_word(text):
    """Return (wake word heard, remaining text cleaned up)."""
    t = text.lower()
    found = WAKE_RE.search(t) is not None
    t = WAKE_RE.sub(" ", t)
    t = re.sub(r"[^a-z0-9\s]", " ", t.replace("'", ""))
    return found, re.sub(r"\s+", " ", t).strip()


def _stem(w):
    return w[:-1] if w.endswith("s") and w[:-1] in SHAPES else w


def _find_relation(t):
    for name, pat in REL_PATTERNS:
        m = re.search(pat, t)
        if m:
            return name, m.start(), m.end()
    return None


def _query_tokens(words):
    return [w for w in words if w not in GENERIC and w not in COLORS and w not in COLOR_ALIASES
            and w not in STYLES and w not in PART_NUMS and not w.isdigit()]


def _part_index(words):
    for i, w in enumerate(words[:-1]):
        if w in ("part", "number", "component"):
            n = words[i + 1]
            if n.isdigit():
                return int(n)
            if n in PART_NUMS:
                return PART_NUMS[n]
    return None


TENS = {"twenty": 20, "thirty": 30, "forty": 40, "fourty": 40, "fifty": 50, "sixty": 60,
        "seventy": 70, "eighty": 80, "ninety": 90}
ONES = {"zero": 0, "one": 1, "two": 2, "three": 3, "four": 4, "five": 5, "six": 6, "seven": 7, "eight": 8,
        "nine": 9, "ten": 10, "eleven": 11, "twelve": 12, "thirteen": 13, "fourteen": 14, "fifteen": 15,
        "sixteen": 16, "seventeen": 17, "eighteen": 18, "nineteen": 19}


def _parse_percent(words):
    """'80', 'eighty five', 'full', 'half', 'idle' -> 0..100 (or None)."""
    for w in words:
        if w.isdigit() and 0 <= int(w) <= 100:
            return int(w)
    for i, w in enumerate(words):
        if w == "hundred":
            return 100
        if w in TENS:
            nxt = words[i + 1] if i + 1 < len(words) else ""
            return TENS[w] + (ONES[nxt] if nxt in ONES and 0 < ONES[nxt] < 10 else 0)
        if w in ONES and ONES[w] >= 10:
            return ONES[w]
    if any(w in words for w in ("full", "max", "maximum")):
        return 100
    if "half" in words:
        return 50
    if "idle" in words:
        return 15
    return None


def _art(word):
    return "an" if word[0] in "aeiou" else "a"


def _parse_clause(t):
    words = [_stem(w) for w in t.split()]
    ws = set(words)
    if not words:
        return None

    def has(*keys):
        return bool(ws & set(keys))

    shape = next((SHAPES[w] for w in words if w in SHAPES), None)
    color = next((COLOR_ALIASES.get(w, w) for w in words if w in COLORS or w in COLOR_ALIASES), None)
    style = next((STYLES[w] for w in words if w in STYLES), None)
    add_verb = has("add", "create", "spawn", "insert", "generate", "build", "draw", "new",
                   "place", "another", "give") or ("make" in ws and has("a", "an", "two", "three", "four", "five"))

    def S(cmd):
        if shape and cmd.kind in SUBJECT_KINDS:
            cmd.args.setdefault("subject", shape)
        return cmd

    if has("help", "commands") or ("what" in ws and has("do", "say")):
        return Command("help", say="I can add shapes, move them in three D, put one inside or on top of "
                       "another, merge and animate parts, and load models. Say Sara, then what you want.")
    if has("model", "modelling", "modeling") and has("make", "create", "build", "turn", "generate") \
            and has("hand", "this", "it", "object", "real"):
        return Command("scan", phrase="start the scanner")
    if has("scan", "scanning", "scanner"):
        if has("cancel", "stop", "abort", "quit", "exit"):
            return Command("scan_cancel", phrase="cancel the scan")
        return Command("scan", phrase="start the scanner")
    if has("capture"):
        return Command("scan_capture", phrase="capture this view")
    if has("finish", "done", "complete") and not shape:
        return Command("scan_finish", phrase="build the model")

    # online options: "show me options on aeroplane engine", "select option 2"
    opt_idx = None
    for i, w in enumerate(words[:-1]):
        if w in ("option", "options") and (words[i + 1].isdigit() or words[i + 1] in PART_NUMS):
            opt_idx = int(words[i + 1]) if words[i + 1].isdigit() else PART_NUMS[words[i + 1]]
    if opt_idx:
        return Command("web_pick", {"index": opt_idx, "action": "open" if has("open", "browser", "website", "page") else None},
                       f"{'open' if has('open', 'browser', 'website', 'page') else 'select'} option {opt_idx}")
    if has("close", "hide", "dismiss") and has("option", "options", "results", "panel"):
        return Command("web_close", phrase="close the options")
    if has("options", "option", "online", "internet", "web", "google", "search"):
        stop = {"show", "me", "options", "option", "on", "for", "about", "of", "a", "an", "the", "some", "various",
                "different", "find", "search", "look", "up", "online", "internet", "web", "please", "can", "you",
                "give", "list", "get", "google", "from", "to", "i", "want", "see", "with", "any", "all", "more"}
        topic = [w for w in words if w not in stop]
        if topic and not has("part", "parts"):
            q = " ".join(topic)
            return Command("web_search", {"query": q}, f"search online for {q}")

    # engine: "start the engine", "thrust to 80 percent", "engine off"
    pct = _parse_percent(words)
    if has("engine", "engines", "thrust", "throttle", "exhaust", "ignite", "ignition", "afterburner") \
            and not add_verb and not has("blade", "fan", "rotor", "propeller", "turbine", "spin", "rotate"):
        if has("exhaust", "nozzle") and has("flip", "reverse", "switch", "swap", "other", "opposite"):
            return Command("engine_flip", phrase="flip the exhaust")
        off = has("off", "stop", "shut", "kill", "disable", "cut", "shutdown")
        on_ = has("on", "start", "ignite", "ignition", "activate", "fire", "begin", "boot", "run", "enable", "power")
        inc, dec = has("increase", "raise", "more", "higher", "up"), has("decrease", "lower", "less", "reduce", "down")
        if inc or dec:
            mag = pct / 100.0 if pct is not None else 0.1        # "by 20 percent" -> relative, not absolute
            delta, pct = (mag if inc else -mag), None
        else:
            delta = None
        thrust_talk = has("thrust", "throttle", "capacity", "percent", "percentage", "full", "max", "maximum", "idle", "half")
        if off and not on_ and not thrust_talk:
            return S(Command("engine", {"on": False}, "turn the engine off"))
        cmds = []
        if on_ and not thrust_talk or (on_ and pct is not None):
            cmds.append(S(Command("engine", {"on": True}, "start the engine")))
        if pct is not None or delta is not None or has("full", "max", "maximum", "idle", "half"):
            words_txt = f"set the thrust to {pct} percent" if pct is not None else \
                ("increase the thrust" if (delta or 0) > 0 else "decrease the thrust")
            cmds.append(S(Command("engine_thrust", {"pct": pct, "delta": delta}, words_txt)))
        if cmds:
            return cmds if len(cmds) > 1 else cmds[0]

    if has("smooth", "smoothen", "smoothing", "polish"):
        return S(Command("smooth", phrase="smooth it"))
    if has("original", "natural", "restore", "real") and has("color", "colour", "colors", "colours"):
        return S(Command("restore_colors", phrase="restore the original colours"))
    if has("align", "aligned", "aligning", "alignment"):
        if has("auto", "automatic", "automatically", "self", "on", "off", "enable", "disable"):
            off = has("off", "disable", "stop", "cancel", "no", "never")
            return Command("autoalign", {"on": not off}, "turn auto align " + ("off" if off else "on"))
        return Command("align", phrase="align it")
    if has("auto", "automatic", "automatically", "snap", "snapping", "magnet", "magnetic"):
        off = has("off", "disable", "stop", "cancel", "no", "never")
        return Command("automerge", {"on": not off}, "turn auto merge " + ("off" if off else "on"))
    if (has("list", "show", "name", "tell", "count") and has("part", "parts", "component", "components")) \
            or ((has("how", "what", "which")) and has("part", "parts", "components")):
        return Command("list_parts", phrase="list the parts")
    if has("load", "upload", "import", "browse") \
            or (has("open") and has("file", "files", "model", "models", "stl", "obj")) \
            or (has("add", "get", "bring") and has("model", "file", "stl", "obj")):
        return Command("load", phrase="open the file browser")
    if has("save", "export"):
        return Command("save", phrase="save your design")
    if has("split", "unmerge", "separate", "detach", "explode"):
        return Command("split", phrase="split it apart")
    if has("merge", "combine", "fuse", "join", "weld", "unite", "attach"):
        shapes_all = [SHAPES[_stem(w)] for w in t.split() if _stem(w) in SHAPES]
        margs = {}
        if len(shapes_all) >= 2:
            margs = {"subject": shapes_all[0], "target": shapes_all[1]}
        elif len(shapes_all) == 1:
            margs = {"target": shapes_all[0]}
        if has("on", "onto", "top", "above"):
            margs["relation"] = "on"
        elif has("under", "below", "beneath"):
            margs["relation"] = "under"
        if margs.get("subject"):
            phrase = f"merge the {margs['subject']} {'onto' if margs.get('relation') == 'on' else 'with'} the {margs['target']}"
        elif margs.get("target"):
            phrase = f"merge it with the {margs['target']}"
        else:
            phrase = "merge the shapes"
        return Command("merge", margs, phrase)
    if has("clear", "delete", "remove", "erase", "destroy", "trash") and \
            (has("all", "everything", "scene", "workspace", "screen", "shapes", "objects") or has("clear")):
        return Command("clear", phrase="clear the workspace")
    if has("delete", "remove", "erase", "destroy", "trash"):
        return S(Command("delete", phrase="delete it"))
    if has("duplicate", "copy", "clone"):
        return S(Command("duplicate", phrase="duplicate it"))

    # relative placement: "put it inside the cube", "add a sphere on top of the cube"
    rel = _find_relation(t)
    if rel:
        name, s0, e0 = rel
        before = [SHAPES[_stem(w)] for w in t[:s0].split() if _stem(w) in SHAPES]
        after = [SHAPES[_stem(w)] for w in t[e0:].split() if _stem(w) in SHAPES]
        if after:
            phrase = f"put it {REL_TEXT[name]} the {after[0]}"
            if add_verb and before:
                adj = (color + " ") if color else ""
                return [Command("add", {"shape": before[-1], "color": color, "count": 1},
                                f"add {_art(adj or before[-1])} {adj}{before[-1]}"),
                        Command("place", {"relation": name, "target": after[0], "subject": None}, phrase)]
            return Command("place", {"relation": name, "target": after[0],
                                     "subject": before[-1] if before else None}, phrase)

    # move in depth / sideways: "move it back", "bring it forward"
    if has(*MOVE_VERBS) or has("closer", "farther", "further", "nearer"):
        d = next((DIRS[w] for w in words if w in DIRS), None)
        if d is None and has("lift", "raise"):
            d = ("y", 1)
        if d is None and has("lower"):
            d = ("y", -1)
        if d:
            amt = 0.8 * (2.0 if has("lot", "much", "far") else 0.4 if has("bit", "little", "slightly", "tiny") else 1.0)
            return S(Command("move", {"axis": d[0], "amount": d[1] * amt}, f"move it {DIR_TEXT[d]}"))

    if shape and add_verb:
        count = next((NUMBERS[w] for w in words if w in NUMBERS), 1)
        adj = (color + " ") if color else ""
        art = NUMBER_TEXT[count]
        if art == "a":
            art = _art(adj or shape)
        return Command("add", {"shape": shape, "color": color, "count": count},
                       f"add {art} {adj}{shape}{'s' if count > 1 else ''}")

    sel_v = has("select", "choose", "pick", "focus", "highlight", "next", "previous", "deselect", "unselect")
    idx, q = _part_index(words), _query_tokens(words)
    if sel_v and (has("part", "parts", "component", "components", "whole", "entire", "deselect", "unselect") or idx):
        if has("whole", "entire", "object", "everything", "deselect", "unselect") and not idx:
            return Command("select_part", {"which": "none"}, "select the whole shape")
        if idx:
            return Command("select_part", {"index": idx}, f"select part {idx}")
        if has("next", "previous"):
            w = "prev" if has("previous") else "next"
            return Command("select_part", {"which": w}, f"select the {'previous' if w == 'prev' else 'next'} part")
        return Command("select_part", {"query": q}, "select the " + (" ".join(q) or "part"))
    qs = [w for w in q if w not in SHAPES]
    if sel_v and qs and not shape:
        return Command("select_part", {"query": qs}, "select the " + " ".join(qs))
    if sel_v:
        which = "prev" if has("previous") else ("next" if not shape else shape)
        return Command("select", {"which": which},
                       "select the " + (which if which in PRIMS else which + " shape"))

    if color:
        return S(Command("color", {"color": color, "query": qs}, f"paint it {color}"))
    if style:
        names = {"holo": "a hologram", "solid": "solid", "wire": "a wireframe"}
        return S(Command("style", {"style": style}, f"make it {names[style]}"))

    # animate parts / whole shape: "spin the blades", "stop the blades", "faster"
    spin_v = has("spin", "rotate", "turn", "orbit", "revolve", "whirl", "animate")
    weak_v = has("start", "run", "activate", "power", "begin")
    stop_v = has("stop", "freeze", "halt", "pause", "disable", "kill")
    speed_w = has("faster", "quicker", "slower", "reverse", "backwards", "opposite") or has("speed", "slow")
    if spin_v or weak_v or stop_v or speed_w:
        axis = next((w for w in words if w in ("x", "y", "z")), None) if has("axis", "around") else None
        if q or idx or has("part", "parts"):
            factor = 0.6 if has("slower", "slow") else 1.6 if has("faster", "quicker", "speed") else None
            on = False if stop_v else (None if (speed_w and not spin_v and not weak_v) else True)
            verb = "stop" if stop_v else ("speed up" if factor and factor > 1 and on is None else
                                          "slow down" if factor and factor < 1 and on is None else "spin")
            return Command("spin_parts", {"query": q, "index": idx, "on": on, "axis": axis, "factor": factor,
                                          "reverse": has("reverse", "backwards", "opposite")},
                           f"{verb} the {' '.join(q) or 'part'}")
        if stop_v:
            return S(Command("spin", {"on": False}, "stop the spin"))
        if spin_v:
            return S(Command("spin", {"on": True}, "spin it"))
        if speed_w:
            return Command("spin_parts", {"query": [], "index": None, "on": None, "axis": None,
                                          "factor": 0.6 if has("slower", "slow") else 1.6 if has("faster", "quicker", "speed") else None,
                                          "reverse": has("reverse", "backwards", "opposite")},
                           "change the speed")

    if has("double", "twice"):
        return S(Command("scale", {"factor": 2.0}, "double its size"))
    if has("half"):
        return S(Command("scale", {"factor": 0.5}, "halve its size"))
    if has("bigger", "larger", "big", "grow", "enlarge", "expand", "increase") or ("scale" in ws and "up" in ws):
        return S(Command("scale", {"factor": 1.3}, "make it bigger"))
    if has("smaller", "small", "shrink", "reduce", "decrease", "tiny", "little") or ("scale" in ws and "down" in ws):
        return S(Command("scale", {"factor": 0.77}, "make it smaller"))
    if has("tall", "taller", "higher", "longer", "elongate", "stretch"):
        return S(Command("stretch", {"axis": "y", "factor": 1.3}, "make it taller"))
    if has("short", "shorter", "squash", "flatten"):
        return S(Command("stretch", {"axis": "y", "factor": 0.77}, "make it shorter"))
    if has("wide", "wider", "fat", "fatter", "thick", "thicker"):
        return S(Command("stretch", {"axis": "xz", "factor": 1.3}, "make it wider"))
    if has("narrow", "narrower", "thin", "thinner", "slim"):
        return S(Command("stretch", {"axis": "xz", "factor": 0.77}, "make it thinner"))
    if has("reset", "straighten", "upright"):
        return S(Command("reset", phrase="reset it"))
    if has("thanks", "thank"):
        return Command("thanks", say="You're welcome.")
    if has("hello", "hi", "hey"):
        return Command("hello", say="Hello. I'm listening.")
    if shape:
        return Command("add", {"shape": shape, "color": None, "count": 1}, f"add {_art(shape)} {shape}")
    return None


def parse_commands(text):
    """Turn a sentence into a list of Commands ('make it tall and blue' -> 2)."""
    _, t = strip_wake_word(text)
    clauses = [c.strip() for c in re.split(r"\b(?:and then|then|and)\b", t) if c.strip()]
    cmds = []
    for clause in clauses:
        r = _parse_clause(clause)
        if isinstance(r, list):
            cmds.extend(r)
        elif r:
            cmds.append(r)
    return cmds


def acknowledgement(cmds):
    for c in cmds:
        if c.say:
            return c.say
    return "Okay, I will " + " and ".join(c.phrase for c in cmds) + "."


# ---------------------------------------------------------------------------
# Studio: all editing logic
# ---------------------------------------------------------------------------
class Studio:
    def __init__(self, renderer):
        self.r = renderer
        self.objects, self.sel = [], None
        self.prims, self.counters, self.spawn_i = {}, {}, 0
        self.auto_merge = AUTO_MERGE
        self.auto_align = AUTO_ALIGN
        self.merge_candidate = None
        self.particles = ParticleSystem()
        self.scanner = None
        self.web = None
        self.speak = lambda text: None
        self.request_file_dialog = lambda: None
        self.toasts = []
        self.mode, self.held = None, None        # None | move | rotate | resize
        self.grab_off, self.rot_last = (0.0, 0.0), None
        self.r_dist0 = self.r_scale0 = 1.0
        self.grab_size = self.grab_z = 1.0
        self.drag_start = None

    # -- helpers ------------------------------------------------------------
    def toast(self, text, secs=3.0):
        self.toasts = (self.toasts + [(text, time.time() + secs)])[-3:]

    def select(self, obj):
        self.sel = obj
        for o in self.objects:
            o.selected = o is obj

    def _primitive_geom(self, kind):
        if kind not in self.prims:
            mesh, deg = build_primitive(kind)
            cols = np.tile(np.array(COLORS["cyan"], np.float32), (len(mesh.faces), 1))
            self.prims[kind] = Geometry(self.r, mesh, cols, edge_flags(mesh, deg))
        return self.prims[kind]

    def _name(self, label):
        self.counters[label] = self.counters.get(label, 0) + 1
        return f"{label} {self.counters[label]}"

    def _free_geom(self, geom):
        if geom in self.prims.values():
            return
        if not any(p.geom is geom for o in self.objects for p in o.parts):
            geom.release()

    def _free_parts(self, parts):
        for p in parts:
            self._free_geom(p.geom)

    def find_object(self, words):
        """Find a scene object whose kind or name matches the spoken words."""
        for o in reversed(self.objects):
            toks = name_tokens(o.name) | {o.kind}
            if any(_plural(w) in toks for w in words):
                return o
        return None

    # -- creation -----------------------------------------------------------
    def add_shape(self, kind, color=None):
        if kind == "engine":
            return self.add_engine()
        i = self.spawn_i
        self.spawn_i += 1
        x = W * (0.30 + 0.08 * (i % 6))
        y = H * (0.50 + (0.13 if (i // 6) % 2 else 0.0))
        name = self._name(kind.title())
        part = Part(self._primitive_geom(kind), name, color or COLOR_CYCLE[i % 6])
        o = SceneObject([part], kind, name, x, y)
        self.objects.append(o)
        self.select(o)
        return o

    def load_model(self, path):
        data = load_model_parts(path)
        total = sum(len(m.faces) for _, m, _ in data)
        deg = 35 if total <= 60000 else 180
        parts = []
        for name, mesh, colors in data:
            own = colors is not None
            if colors is None:
                colors = np.tile(np.array(COLORS["cyan"], np.float32), (len(mesh.faces), 1))
            parts.append(Part(Geometry(self.r, mesh, colors, edge_flags(mesh, deg)), name, "cyan", not own))
        i = self.spawn_i
        self.spawn_i += 1
        label = os.path.splitext(os.path.basename(path))[0][:14]
        o = SceneObject(parts, "model", self._name(label), W * (0.42 + 0.06 * (i % 4)), H * 0.5, scale=1.5)
        self.objects.append(o)
        self.select(o)
        return o

    def duplicate(self):
        o = self.sel
        if o is None:
            return "There is nothing selected."
        parts = [Part(p.geom, p.name, p.color_name, p.override) for p in o.parts]
        c = SceneObject(parts, o.kind, self._name(o.name.rsplit(" ", 1)[0]),
                        clamp(o.x + 90, 300, W - 300), clamp(o.y + 60, 120, H - 120), o.z, o.scale)
        c.stretch, c.ax, c.ay, c.style = o.stretch.copy(), o.ax, o.ay, o.style
        c.R0 = o.R0.copy()
        self.objects.append(c)
        self.select(c)
        return None

    def delete_selected(self):
        o = self.sel
        if o is None:
            return "There is nothing selected."
        self.objects.remove(o)
        self._free_parts(o.parts)
        if self.held is o:
            self.held, self.mode = None, None
        self.select(self.objects[-1] if self.objects else None)
        return None

    def clear_all(self):
        parts = [p for o in self.objects for p in o.parts]
        self.objects.clear()
        self._free_parts(parts)
        self.held, self.mode = None, None
        self.select(None)

    # -- 3D geometry queries ---------------------------------------------------
    def world_aabb(self, o, target=False):
        lo, hi = o.local_bounds
        corners = np.array([[x, y, z, 1.0] for x in (lo[0], hi[0]) for y in (lo[1], hi[1])
                            for z in (lo[2], hi[2])], np.float32)
        w = (o.model_matrix(self.r, target) @ corners.T).T[:, :3]
        return w.min(0), w.max(0)

    def place_relative(self, subj, target, relation):
        """Put `subj` on top of / inside / behind ... `target` in 3D world space."""
        r = self.r
        lo_b, hi_b = self.world_aabb(target, True)
        cb, sb = (lo_b + hi_b) / 2, hi_b - lo_b
        lo_a, hi_a = self.world_aabb(subj, True)
        sa, ca = hi_a - lo_a, (lo_a + hi_a) / 2
        pos = np.array(r.unproject(subj.tx, subj.ty, subj.tz))
        off = ca - pos
        if relation == "inside":
            fit = 0.75 * float(np.min(sb / np.maximum(sa, 1e-6)))
            if fit < 1.0:
                subj.scale = max(MIN_SCALE, subj.scale * fit)
                sa, off = sa * fit, off * fit
            c = cb
        elif relation == "on":
            c = np.array([cb[0], hi_b[1] + sa[1] / 2, cb[2]])
        elif relation == "under":
            c = np.array([cb[0], lo_b[1] - sa[1] / 2, cb[2]])
        elif relation == "behind":
            c = np.array([cb[0], cb[1], lo_b[2] - sa[2] / 2])
        elif relation == "front":
            c = np.array([cb[0], cb[1], hi_b[2] + sa[2] / 2])
        elif relation == "left":
            c = np.array([lo_b[0] - sa[0] / 2, cb[1], cb[2]])
        else:
            c = np.array([hi_b[0] + sa[0] / 2, cb[1], cb[2]])
        new = c - off
        x, y = r.project(*new)
        subj.tx, subj.ty = clamp(x, 0, W), clamp(y, 0, H)
        subj.tz = clamp(float(new[2]), Z_MIN, Z_MAX)

    # -- merge with snapping -----------------------------------------------------
    def _tolerance(self, lo_a, hi_a, lo_b, hi_b):
        dim = min(float((hi_a - lo_a).max()), float((hi_b - lo_b).max()))
        t = clamp(max(SNAP_ABS, SNAP_REL * dim), 0.0, SNAP_MAX)
        return np.array([t, t, t * SNAP_Z_FACTOR])

    def find_contact(self, a):
        """Nearest other shape that `a` touches, overlaps, or almost touches."""
        best = None
        lo_a, hi_a = self.world_aabb(a, True)
        for b in self.objects:
            if b is a:
                continue
            lo_b, hi_b = self.world_aabb(b, True)
            tol = self._tolerance(lo_a, hi_a, lo_b, hi_b)
            gap = np.maximum(lo_a - hi_b, lo_b - hi_a)         # >0 apart, <0 overlapping
            if np.any(gap > tol):
                continue
            inside = (np.all(lo_a >= lo_b - 1e-3) and np.all(hi_a <= hi_b + 1e-3)) or \
                     (np.all(lo_b >= lo_a - 1e-3) and np.all(hi_b <= hi_a + 1e-3))
            if inside:                                          # deliberate nesting, leave it
                continue
            score = float(gap.max())
            if best is None or score < best["score"]:
                best = {"score": score, "b": b, "gap": gap, "tol": tol,
                        "a": (lo_a, hi_a), "bb": (lo_b, hi_b)}
        return best

    # -- self-alignment ---------------------------------------------------------
    def _volume(self, o):
        lo, hi = self.world_aabb(o, True)
        return float(np.prod(np.maximum(hi - lo, 1e-6)))

    def pick_roles(self, a, b):
        """The smaller shape is the one that moves onto the larger one."""
        return (a, b) if self._volume(a) <= 1.25 * self._volume(b) else (b, a)

    def _nested(self, a, b):
        lo_a, hi_a = self.world_aabb(a, True)
        lo_b, hi_b = self.world_aabb(b, True)
        return bool((np.all(lo_a >= lo_b - 1e-3) and np.all(hi_a <= hi_b + 1e-3))
                    or (np.all(lo_b >= lo_a - 1e-3) and np.all(hi_b <= hi_a + 1e-3)))

    def _geom_world(self, o):
        """World-space centre, rotation, scale, hull points and flat faces of an object."""
        M = o.model_matrix(self.r, True)
        R = o.rot4()[:3, :3].astype(np.float64)
        s = (o.stretch * o.scale).astype(np.float64)
        c = M[:3, 3].astype(np.float64)
        hull = np.vstack([p.geom.hull for p in o.parts])
        facets = []
        for p in o.parts:
            for f in p.geom.facets:
                nw = R @ (f["n"] / s)
                nw /= np.linalg.norm(nw) + 1e-12
                facets.append({"nw": nw, "cw": R @ (f["c"] * s) + c, "n": f["n"], "c": f["c"]})
        return {"c": c, "R": R, "s": s, "hull": (R @ (hull * s).T).T + c, "hull_local": hull, "facets": facets}

    def align_pair(self, m, b, hint=None, center=False):
        """Re-orient and move `m` so it sits flush, edge-aligned and centred on `b`.
        Works with any shapes: it finds the face of `b` being touched, lays the flat face of
        `m` that already points that way onto it, squares up the edges (multiples of 90 deg)
        and centres it, so hand-placement errors disappear."""
        gb, gm = self._geom_world(b), self._geom_world(m)
        cb, cm = gb["c"], gm["c"]
        d = cm - cb
        d = np.array([0.0, 1.0, 0.0]) if np.linalg.norm(d) < 1e-6 else d / np.linalg.norm(d)
        if hint is not None:
            d = np.asarray(hint, np.float64)
        fb = None
        if gb["facets"]:
            best = max(gb["facets"], key=lambda f: float(f["nw"] @ d))
            if float(best["nw"] @ d) > 0.45:
                fb = best
        n_c = fb["nw"] if fb is not None else d

        R_new, fm = gm["R"], None
        if gm["facets"]:
            cand = max(gm["facets"], key=lambda f: float(f["nw"] @ -n_c))
            if float(cand["nw"] @ -n_c) > 0.2:
                fm = cand
        if fm is not None:
            R_new = rot_between(fm["nw"], -n_c) @ gm["R"]
            t_b = gb["R"] @ np.array([1.0, 0.0, 0.0])
            t_b = t_b - n_c * (t_b @ n_c)
            if np.linalg.norm(t_b) < 0.3:
                t_b = gb["R"] @ np.array([0.0, 0.0, 1.0])
                t_b = t_b - n_c * (t_b @ n_c)
            t_b /= np.linalg.norm(t_b) + 1e-12
            p = R_new @ np.eye(3)[int(np.argmin(np.abs(fm["n"])))]
            p = p - n_c * (p @ n_c)
            if np.linalg.norm(p) > 1e-6:
                p /= np.linalg.norm(p)
                ang = math.atan2(float(np.cross(t_b, p) @ n_c), float(t_b @ p))
                corr = ang - round(ang / (math.pi / 2)) * (math.pi / 2)
                R_new = axis_angle(n_c, -corr)[:3, :3].astype(np.float64) @ R_new

        s = gm["s"]
        if fb is not None:
            s_b = float((fb["cw"] - cb) @ n_c)
            t_ref = (fb["cw"] - cb) - n_c * s_b
        else:
            s_b = float(np.max((gb["hull"] - cb) @ n_c))
            t_ref = np.zeros(3)
        rel = cm - cb
        t_user = rel - n_c * float(rel @ n_c)
        t_target = t_ref
        if fb is not None and not center:
            off = t_user - t_ref
            if np.linalg.norm(off) > 1e-6:
                half = float(np.max((gb["hull"] - fb["cw"]) @ (off / np.linalg.norm(off))))
                if np.linalg.norm(off) > ALIGN_CENTER_FRAC * max(half, 1e-3):
                    t_target = t_user                      # you meant it off-centre: keep it
        q = cb + n_c * s_b + t_target
        if fm is not None:
            new_c = q - R_new @ (fm["c"] * s)
        else:
            hm = (R_new @ (gm["hull_local"] * s).T).T
            new_c = q + n_c * float(np.max(hm @ -n_c))

        m.R0 = np.eye(4, dtype=np.float32)
        m.R0[:3, :3] = R_new
        m.ax = m.ay = 0.0
        x, y = self.r.project(*new_c)
        m.x = m.tx = clamp(x, 0, W)
        m.y = m.ty = clamp(y, 0, H)
        m.z = m.tz = clamp(float(new_c[2]), Z_MIN, Z_MAX)
        return {"moved": float(np.linalg.norm(new_c - cm)), "flat": fm is not None}

    def merge_pair(self, a, b, hint=None, center=False, roles=None):
        moving, base = roles if roles else self.pick_roles(a, b)
        info = None
        if self.auto_align and not self._nested(moving, base):
            info = self.align_pair(moving, base, hint, center)
        return self.merge_objects(base, moving), info

    def merge_selected(self, subject=None, target=None, relation=None):
        a = self.sel
        if subject:
            m = [o for o in self.objects if o.kind == subject]
            if m:
                a = m[-1]
        if a is None or len(self.objects) < 2:
            return "I need at least two shapes to merge."
        roles = None
        if target:
            c = [o for o in self.objects if o.kind == target and o is not a]
            if not c:
                return f"I can't find a {target} to merge with."
            b = min(c, key=lambda o: math.hypot(o.x - a.x, o.y - a.y))
            roles = (a, b)
        else:
            info = self.find_contact(a)
            b = info["b"] if info else min((o for o in self.objects if o is not a),
                                           key=lambda o: math.hypot(o.x - a.x, o.y - a.y) + 40 * abs(o.z - a.z))
        hint = {"on": (0, 1, 0), "under": (0, -1, 0)}.get(relation)
        self.merge_pair(a, b, hint, True, roles)
        return None

    def align_selected(self):
        a = self.sel
        if a is None or len(self.objects) < 2:
            return "I need two shapes to align."
        info = self.find_contact(a)
        b = info["b"] if info else min((o for o in self.objects if o is not a),
                                       key=lambda o: math.hypot(o.x - a.x, o.y - a.y) + 40 * abs(o.z - a.z))
        moving, base = self.pick_roles(a, b)
        self.align_pair(moving, base, None, True)
        self.toast("ALIGNED")
        return None

    def merge_objects(self, a, b):
        """Fuse two shapes into one object that keeps every part."""
        data = []
        for o in (a, b):
            M = o.model_matrix(self.r)
            for p in o.parts:
                m = p.geom.mesh.copy()
                m.apply_transform(M @ o.part_transform(p))       # bake the current pose
                data.append((m, p.face_colors(), p.geom.flags, p.name))
        allv = np.vstack([m.vertices for m, *_ in data])
        lo, hi = allv.min(0), allv.max(0)
        center, ext = (lo + hi) / 2, float((hi - lo).max())
        parts = []
        for m, cols, fl, name in data:
            m.apply_translation(-center)
            m.apply_scale(1.0 / ext)
            parts.append(Part(Geometry(self.r, m, cols, fl), name, "cyan", False))
        x, y = self.r.project(*center)
        merged = SceneObject(parts, "merged", self._name("Merged"), clamp(x, 0, W), clamp(y, 0, H),
                             clamp(float(center[2]), Z_MIN, Z_MAX), scale=ext)
        merged.ax = merged.ay = 0.0
        merged.style = a.style
        old = a.parts + b.parts
        for o in (a, b):
            self.objects.remove(o)
        self._free_parts(old)
        self.objects.append(merged)
        self.select(merged)
        self.held, self.mode = None, None
        return merged

    def split_selected(self):
        o = self.sel
        if o is None or o.kind != "merged" or len(o.parts) < 2:
            return "Only merged shapes can be split."
        M = o.model_matrix(self.r)
        new = []
        for p in o.parts:
            m = p.geom.mesh.copy()
            m.apply_transform(M @ o.part_transform(p))
            lo, hi = m.bounds
            center, ext = (lo + hi) / 2, float((hi - lo).max())
            m.apply_translation(-center)
            m.apply_scale(1.0 / max(ext, 1e-6))
            geom = Geometry(self.r, m, p.face_colors(), p.geom.flags)
            base = p.name.rsplit(" ", 1)[0].lower()
            kind = base if base in PRIMS else "model"
            x, y = self.r.project(*center)
            po = Part(geom, p.name, p.color_name, p.override)
            po.override, po.color_name = p.override, p.color_name
            n = SceneObject([po], kind, p.name, clamp(x, 0, W), clamp(y, 0, H),
                            clamp(float(center[2]), Z_MIN, Z_MAX), scale=max(ext, 0.1))
            n.ax = n.ay = 0.0
            n.style = o.style
            new.append(n)
        self.objects.remove(o)
        self._free_parts(o.parts)
        self.objects.extend(new)
        self.select(new[-1])
        return None

    def _moved(self, o):
        s = self.drag_start
        if not s:
            return False
        return (math.hypot(o.tx - s[0], o.ty - s[1]) > DRAG_MIN_PX or abs(o.tz - s[2]) > 0.2
                or abs(o.scale / s[3] - 1) > 0.08)

    def _on_drop(self, a):
        """Let go of a shape touching another: self-align it and merge."""
        info = self.find_contact(a)
        if not info:
            return
        _, ainfo = self.merge_pair(a, info["b"])
        self.toast("ALIGNED + MERGED" if ainfo else "MERGED")
        self.speak("Aligned and merged." if ainfo else "Merged.")

    # -- engine, scanning, design extras ----------------------------------------------
    def add_engine(self):
        data, lo, hi, rad = build_engine_parts()
        parts = [Part(Geometry(self.r, mesh, cols, edge_flags(mesh, 25)), name, "cyan", False)
                 for name, mesh, cols in data]
        i = self.spawn_i
        self.spawn_i += 1
        o = SceneObject(parts, "engine", self._name("Engine"), W * (0.42 + 0.05 * (i % 4)), H * 0.5, scale=1.9)
        o.ax, o.ay = 0.15, -0.55
        o.engine = Engine((lo, hi), [1, 0, 0], 1, rad)
        rotor = [p for p in parts if p.name.startswith("Fan_Blade") or p.name == "Spinner"]
        gp = np.vstack([p.geom.mesh.vertices for p in rotor])
        sp = Spinner((gp.min(0) + gp.max(0)) / 2, [1, 0, 0], 0.0)
        sp.on, sp.engine_driven = False, True
        for p in rotor:
            p.spinner = sp
        self.objects.append(o)
        self.select(o)
        return o

    def make_engine(self, o):
        """Turn any object into an engine: find the rotor, the axis and the exhaust end."""
        pts = np.vstack([p.geom.hull for p in o.parts])
        rotor = match_parts(o, ["blade"]) if len(o.parts) > 1 else []
        if rotor:
            group = [o.parts[i] for i in rotor]
            axis = auto_axis(np.vstack([p.geom.mesh.vertices for p in group]))
        else:
            w, v = np.linalg.eigh(np.cov((pts - pts.mean(0)).T))
            axis = v[:, 2]
        axis = unit(axis)
        proj = pts @ axis
        lo, hi = float(proj.min()), float(proj.max())
        length = max(hi - lo, 1e-6)

        def radius_at(sel):
            q = pts[sel]
            return float(np.linalg.norm(q - np.outer(q @ axis, axis), axis=1).mean()) if len(q) else 0.0
        r_hi, r_lo = radius_at(proj > hi - 0.2 * length), radius_at(proj < lo + 0.2 * length)
        line = pts.mean(0) - axis * float(pts.mean(0) @ axis)
        e = Engine((line + axis * lo, line + axis * hi), axis, 1 if r_hi <= r_lo else -1,
                   max(0.03, 0.6 * min(r_hi, r_lo)))
        if rotor:
            gp = np.vstack([p.geom.mesh.vertices for p in group])
            sp = Spinner((gp.min(0) + gp.max(0)) / 2, axis, 0.0)
            sp.on, sp.engine_driven = False, True
            for p in group:
                p.spinner = sp
        o.engine = e
        return e

    def engine_command(self, k, a):
        o = self.sel
        if o is None:
            return "There is nothing selected."
        e = o.engine or self.make_engine(o)
        if k == "engine_flip":
            e.sign = -e.sign
            self.toast("EXHAUST FLIPPED")
        elif k == "engine":
            e.on = a["on"]
            if e.on and e.thrust < 0.05:
                e.thrust = 0.5
            self.toast("ENGINE " + ("ON" if e.on else "OFF"))
        else:
            pct, delta = a.get("pct"), a.get("delta") or 0.0
            e.thrust = clamp(pct / 100.0 if pct is not None else e.thrust + delta, 0.0, 1.0)
            self.toast(f"THRUST {int(round(e.thrust * 100))}%")
            if not e.on:
                self.speak(f"Thrust is set to {int(round(e.thrust * 100))} percent. The engine is off. "
                           "Say start the engine.")
        return None

    def _update_engine(self, o, dt):
        e = o.engine
        e.rpm += ((e.thrust if e.on else 0.0) - e.rpm) * (1.0 - math.exp(-dt * 1.6))
        for s in o.spinners():
            if s.engine_driven:
                s.on = e.rpm > 0.01
                s.speed = math.copysign(2.0 + 26.0 * e.rpm, s.speed if s.speed else 1.0)
        if e.rpm < 0.02:
            return
        e.acc += (30.0 + 520.0 * e.rpm) * dt
        k = int(e.acc)
        e.acc -= k
        if k <= 0:
            return
        origin = (o.model_matrix(self.r) @ np.append(e.nozzle, 1.0).astype(np.float32))[:3]
        sc = o.scale
        self.particles.emit(origin, o.rot4()[:3, :3] @ e.direction, k, (0.9 + 3.6 * e.rpm) * sc,
                            0.10 + 0.12 * e.rpm, 0.45 + 0.9 * e.rpm, 0.11 * sc * (0.8 + 0.5 * e.rpm),
                            e.radius * sc)

    def add_scanned(self, mesh, colors):
        geom = Geometry(self.r, mesh, colors, np.zeros((len(mesh.faces), 3), np.float32))
        o = SceneObject([Part(geom, "Scan", "cyan", False)], "scan", self._name("Scan"),
                        W * 0.5, H * 0.5, scale=1.8)
        o.ax, o.ay = 0.15, 0.4
        self.objects.append(o)
        self.select(o)
        return o

    def smooth_selected(self):
        o = self.sel
        if o is None:
            return "There is nothing selected."
        for p in o.parts:
            old = p.geom
            p.geom = Geometry(self.r, smooth_mesh(old.mesh), old.face_colors, old.flags)
            self._free_geom(old)
        o.refresh_bounds()
        self.toast("SMOOTHED")
        return None

    def restore_colors(self):
        o = self.sel
        if o is None:
            return "There is nothing selected."
        for p in o.parts:
            p.override = False
        self.toast("ORIGINAL COLOURS")
        return None

    # -- parts: select, list, animate ----------------------------------------------
    def select_part(self, a):
        o = self.sel
        if o is None:
            return "There is nothing selected."
        n = len(o.parts)
        if a.get("which") == "none":
            o.focus = None
            self.toast("WHOLE SHAPE SELECTED")
            return None
        if a.get("index"):
            i = a["index"] - 1
            if not 0 <= i < n:
                return f"There is no part {a['index']}."
            o.focus = i
        elif a.get("query"):
            idx = match_parts(o, a["query"])
            if not idx:
                other = self.find_object(a["query"])
                if other:
                    self.select(other)
                    return None
                return f"I couldn't find a part called {' '.join(a['query'])}."
            o.focus = idx[0]
        elif a.get("which") in ("next", "prev"):
            step = 1 if a["which"] == "next" else -1
            o.focus = (0 if step > 0 else n - 1) if o.focus is None else (o.focus + step) % n
        self.toast(f"PART {o.focus + 1}: {o.parts[o.focus].name.upper()}")
        self.speak(f"Part {o.focus + 1}, {o.parts[o.focus].name}.")
        return None

    def list_parts(self):
        o = self.sel
        if o is None:
            return "There is nothing selected."
        names = [p.name for p in o.parts]
        if len(names) == 1:
            return "This shape is a single part."
        extra = "" if len(names) <= 5 else f", and {len(names) - 5} more"
        self.speak(f"This shape has {len(names)} parts: " + ", ".join(names[:5]) + extra + ".")
        return None

    def spin_parts(self, a):
        o = self.sel
        if o is None:
            return "There is nothing selected."
        query, idxs = a.get("query") or [], None
        if a.get("index"):
            i = a["index"] - 1
            if not 0 <= i < len(o.parts):
                return f"There is no part {a['index']}."
            idxs = [i]
        elif query:
            idxs = match_parts(o, query)
            if not idxs:
                other = self.find_object(query)
                if other:                                        # "spin the sphere" = whole shape
                    self.select(other)
                    other.spin = a["on"] is not False
                    return None
                return f"I couldn't find parts called {' '.join(query)}. Say list the parts."
        elif o.focus is not None:
            idxs = [o.focus]
        else:
            running = [s for s in o.spinners() if s.on]
            for s in running:
                s.speed *= a.get("factor") or 1.0
                s.speed = -s.speed if a.get("reverse") else s.speed
            if not running:
                if a.get("factor"):
                    o.spin_speed *= a["factor"]
                    return None
                return "Tell me which part, for example: spin the blades."
            return None

        group = [o.parts[i] for i in idxs]
        if a.get("on") is False:
            for p in group:
                if p.spinner:
                    p.spinner.on = False
            return None
        shared = group[0].spinner
        if shared is None or any(p.spinner is not shared for p in group) or a.get("axis"):
            pts = np.vstack([p.geom.mesh.vertices for p in group])
            pivot = (pts.min(0) + pts.max(0)) / 2
            axis = {"x": [1, 0, 0], "y": [0, 1, 0], "z": [0, 0, 1]}.get(a.get("axis")) \
                if a.get("axis") else auto_axis(pts)
            shared = Spinner(pivot, axis)
            for p in group:
                p.spinner = shared
        shared.on = True
        if a.get("factor"):
            shared.speed *= a["factor"]
        if a.get("reverse"):
            shared.speed = -shared.speed
        self.toast(f"SPINNING {len(group)} PART{'S' if len(group) > 1 else ''}", 2)
        return None

    # -- command execution ---------------------------------------------------------
    def execute(self, cmd):
        """Run one parsed command. Returns an error sentence (spoken) or None."""
        k, a = cmd.kind, cmd.args
        if k == "add":
            for _ in range(a.get("count", 1)):
                self.add_shape(a["shape"], a.get("color"))
            self.toast(f"ADDED {a['shape'].upper()}")
            return None
        if k == "load":
            self.request_file_dialog()
            return None
        if k == "load_path":
            try:
                obj = self.load_model(a["path"])
                self.toast(f"LOADED {obj.name.upper()} ({len(obj.parts)} PARTS)")
                self.speak(f"Loaded {obj.name}. It has {len(obj.parts)} parts.")
            except Exception as exc:
                self.toast("LOAD FAILED: " + str(exc)[:60], 5)
                self.speak("Sorry, I could not load that file.")
            return None
        if k == "clear":
            self.clear_all()
            self.toast("WORKSPACE CLEARED")
            return None
        if k == "automerge":
            self.auto_merge = a["on"]
            self.toast("AUTO-MERGE " + ("ON" if self.auto_merge else "OFF"))
            return None
        if k == "merge":
            err = self.merge_selected(a.get("subject"), a.get("target"), a.get("relation"))
            self.toast(err or "MERGED")
            return err
        if k == "split":
            err = self.split_selected()
            self.toast(err or "SPLIT")
            return err
        if k == "save":
            return self.export_selected()
        if k == "select":
            return self.select_by(a.get("which"))
        if k == "place":
            return self.do_place(a)
        subj = a.get("subject")
        if subj and k in SUBJECT_KINDS:
            match = [x for x in self.objects if x.kind == subj]
            if match:
                self.select(match[-1])
        o = self.sel
        if k in ("scan", "scan_capture", "scan_finish", "scan_cancel"):
            sc = self.scanner
            if sc is None:
                return "Scanning is not available."
            return {"scan": sc.start, "scan_capture": sc.capture_now,
                    "scan_finish": sc.finish, "scan_cancel": sc.cancel}[k]()
        if k in ("web_search", "web_pick", "web_close"):
            if self.web is None:
                return "Online search is not available."
            if k == "web_search":
                return self.web.search(a["query"])
            if k == "web_pick":
                return self.web.pick(a["index"], a.get("action"))
            self.web.visible = False
            return None
        if k in ("engine", "engine_thrust", "engine_flip"):
            return self.engine_command(k, a)
        if k == "align":
            return self.align_selected()
        if k == "autoalign":
            self.auto_align = a["on"]
            self.toast("AUTO-ALIGN " + ("ON" if self.auto_align else "OFF"))
            return None
        if k == "smooth":
            return self.smooth_selected()
        if k == "restore_colors":
            return self.restore_colors()
        if k == "delete":
            err = self.delete_selected()
            self.toast(err or "DELETED")
            return err
        if k == "duplicate":
            err = self.duplicate()
            self.toast(err or "DUPLICATED")
            return err
        if k == "list_parts":
            return self.list_parts()
        if o is None:
            return "There is nothing selected."
        if k == "select_part":
            return self.select_part(a)
        if k == "spin_parts":
            return self.spin_parts(a)
        if k == "color":
            idxs = match_parts(o, a["query"]) if a.get("query") else []
            targets = [o.parts[i] for i in idxs] if idxs else \
                ([o.parts[o.focus]] if o.focus is not None else o.parts)
            for p in targets:
                p.color_name, p.override = a["color"], True
        elif k == "style":
            o.style = a["style"]
        elif k == "scale":
            o.scale = clamp(o.scale * a["factor"], MIN_SCALE, MAX_SCALE)
        elif k == "stretch":
            for ax in ([1] if a["axis"] == "y" else [0, 2]):
                o.stretch[ax] = clamp(o.stretch[ax] * a["factor"], 0.3, 4.0)
        elif k == "spin":
            o.spin = a["on"]
            if not a["on"]:
                for s in o.spinners():
                    s.on = False
        elif k == "move":
            if a["axis"] == "z":
                o.tz = clamp(o.tz + a["amount"], Z_MIN, Z_MAX)
            elif a["axis"] == "x":
                o.tx = clamp(o.tx + a["amount"] * self.r.px_per_world(o.z), 0, W)
            else:
                o.ty = clamp(o.ty - a["amount"] * self.r.px_per_world(o.z), 0, H)
        elif k == "reset":
            o.ax, o.ay = 0.35, 0.6
            o.R0 = np.eye(4, dtype=np.float32)
            o.stretch[:] = 1.0
        self.toast(k.upper() + " OK", 1.5)
        return None

    def do_place(self, a):
        subj = None
        if a.get("subject"):
            m = [x for x in self.objects if x.kind == a["subject"]]
            subj = m[-1] if m else None
        subj = subj or self.sel
        if subj is None:
            return "There is nothing selected."
        cands = [x for x in self.objects if x.kind == a["target"] and x is not subj]
        if not cands:
            return f"I can't find a {a['target']} to use."
        target = min(cands, key=lambda x: math.hypot(x.x - subj.x, x.y - subj.y))
        rel = a["relation"]
        hints = {"on": (0, 1, 0), "under": (0, -1, 0), "left": (-1, 0, 0), "right": (1, 0, 0),
                 "front": (0, 0, 1), "behind": (0, 0, -1)}
        if rel != "inside" and self.auto_align:
            self.align_pair(subj, target, hints[rel], True)       # flush, squared up and centred
        else:
            self.place_relative(subj, target, rel)
        self.select(subj)
        if a["relation"] == "inside" and target.style == "solid":
            target.style = "holo"
            self.speak("I made the outer shape a hologram so you can see inside.")
        self.toast(f"PLACED {REL_TEXT[a['relation']].upper()} {target.name.upper()}")
        return None

    def select_by(self, which):
        if not self.objects:
            return "There is nothing to select."
        idx = self.objects.index(self.sel) if self.sel in self.objects else -1
        if which == "next":
            self.select(self.objects[(idx + 1) % len(self.objects)])
        elif which == "prev":
            self.select(self.objects[(idx - 1) % len(self.objects)])
        else:
            m = [o for o in self.objects if o.kind == which]
            if not m:
                return f"I can't find a {which}."
            self.select(m[-1])
        return None

    def cycle_color(self):
        o = self.sel
        if o:
            targets = [o.parts[o.focus]] if o.focus is not None else o.parts
            i = COLOR_CYCLE.index(targets[0].color_name)
            for p in targets:
                p.color_name, p.override = COLOR_CYCLE[(i + 1) % len(COLOR_CYCLE)], True

    def cycle_style(self):
        if self.sel:
            self.sel.style = STYLE_CYCLE[(STYLE_CYCLE.index(self.sel.style) + 1) % 3]

    def toggle_focus_spin(self):
        o = self.sel
        if o is None or o.focus is None:
            self.toast("SELECT A PART FIRST (P)")
            return
        p = o.parts[o.focus]
        if p.spinner is not None and p.spinner.on:
            p.spinner.on = False
        else:
            self.spin_parts({"index": o.focus + 1, "on": True})

    def export_selected(self):
        o = self.sel
        if o is None:
            return "There is nothing selected."
        M = o.rot4() @ scale_m(*(o.stretch * o.scale))
        metas = []
        for p in o.parts:
            m = p.geom.mesh.copy()
            m.apply_transform(M @ o.part_transform(p))
            metas.append((m, p.face_colors()))
        mesh = trimesh.util.concatenate([m for m, _ in metas])
        rgba = np.full((len(mesh.faces), 4), 255, np.uint8)
        rgba[:, :3] = (np.vstack([c for _, c in metas]) * 255).astype(np.uint8)
        out = trimesh.Trimesh(vertices=mesh.vertices, faces=mesh.faces, face_colors=rgba, process=False)
        folder = os.path.join(BASE_DIR, "sara_exports")
        os.makedirs(folder, exist_ok=True)
        stem = os.path.join(folder, f"{o.name.replace(' ', '_')}_{int(time.time())}")
        out.export(stem + ".stl")
        out.export(stem + ".ply")
        self.toast("SAVED TO sara_exports/", 4)
        return None

    # -- gestures ------------------------------------------------------------------
    def pick(self, pt):
        """Smallest shape under the pinch wins, so small shapes inside big ones stay reachable."""
        best, best_r = None, 1e9
        for o in self.objects:
            rr = o.radius_px(self.r) * 1.1
            if math.hypot(o.x - pt[0], o.y - pt[1]) <= rr and rr < best_r:
                best, best_r = o, rr
        return best

    def _grab(self, target, pt, size):
        self.held, target.held, self.mode = target, True, "move"
        self.grab_off = (target.x - pt[0], target.y - pt[1])
        self.grab_size, self.grab_z = max(size, 1.0), target.tz
        self.drag_start = (target.tx, target.ty, target.tz, target.scale)
        self.select(target)

    def _release(self):
        held, mode = self.held, self.mode
        if held:
            held.held = False
        self.held, self.mode, self.rot_last = None, None, None
        if held and mode in ("move", "resize") and held in self.objects and self.auto_merge \
                and self._moved(held):
            self._on_drop(held)
        self.drag_start = None

    def handle_gestures(self, pinches):
        """pinches: list of (x, y, hand_size) for hands that are pinching."""
        n = len(pinches)
        if n >= 2:
            (ax, ay, _), (bx, by, _) = pinches[0], pinches[1]
            mid, dist = ((ax + bx) / 2, (ay + by) / 2), math.hypot(bx - ax, by - ay)
            if self.mode != "resize":
                target = self.held or self.pick(mid) or self.sel
                if target is None:
                    return
                if self.held and self.held is not target:
                    self.held.held = False
                if self.drag_start is None:
                    self.drag_start = (target.tx, target.ty, target.tz, target.scale)
                self.held, target.held, self.mode = target, True, "resize"
                self.r_dist0, self.r_scale0 = max(dist, 1.0), target.scale
                self.select(target)
            t = self.held
            t.scale = clamp(self.r_scale0 * dist / self.r_dist0, MIN_SCALE, MAX_SCALE)
            t.tx, t.ty = mid
        elif n == 1:
            x, y, size = pinches[0]
            pt = (x, y)
            if self.mode == "resize":
                self.mode = "move"
                self.grab_off = (self.held.x - x, self.held.y - y)
                self.grab_size, self.grab_z = max(size, 1.0), self.held.tz
            elif self.mode is None:
                target = self.pick(pt)
                if target:
                    self._grab(target, pt, size)
                elif self.sel:
                    self.mode, self.rot_last = "rotate", pt
            elif self.mode == "move":
                h = self.held
                h.tx, h.ty = x + self.grab_off[0], y + self.grab_off[1]
                if HAND_DEPTH:
                    d = size / self.grab_size - 1.0
                    if abs(d) > DEPTH_DEADZONE:
                        d = (abs(d) - DEPTH_DEADZONE) * (1 if d > 0 else -1) * DEPTH_GAIN
                        h.tz = clamp(self.grab_z + d, Z_MIN, Z_MAX)
                    else:
                        h.tz = self.grab_z
            elif self.mode == "rotate" and self.sel and self.rot_last:
                self.sel.ay += (x - self.rot_last[0]) * 0.012
                self.sel.ax += (y - self.rot_last[1]) * 0.012
                self.rot_last = pt
        else:
            self._release()

    def update(self, dt):
        k = 1.0 - math.exp(-dt * 22.0)
        for o in self.objects:
            o.x += (o.tx - o.x) * k
            o.y += (o.ty - o.y) * k
            o.z += (o.tz - o.z) * k
            o.x, o.y = clamp(o.x, 0, W), clamp(o.y, 0, H)
            if o.spin and not o.held:
                o.ay += dt * o.spin_speed
            if o.engine:
                self._update_engine(o, dt)
            for s in o.spinners():
                s.advance(dt)
        self.particles.update(dt)
        cand = None
        if self.held and self.auto_merge and self.held in self.objects:
            info = self.find_contact(self.held)
            cand = info["b"] if info else None
        self.merge_candidate = cand


