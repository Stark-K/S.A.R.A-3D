class Backdrop:
    def __init__(self, width, height):
        ys, xs = np.mgrid[0:height, 0:width].astype(np.float32)
        d = np.sqrt(((xs - width / 2) / (width / 2)) ** 2 + ((ys - height / 2) / (height / 2)) ** 2)
        v = np.clip(1.15 - 0.55 * d, 0.35, 1.0)
        self.vig = (v[..., None] * np.array([255, 232, 205], np.float32)).astype(np.uint8)

    def apply(self, frame, t):
        bg = cv2.multiply(frame, self.vig, scale=BG_BRIGHTNESS / 255.0)
        y = int((t * 120) % H)
        cv2.line(bg, (0, y), (W, y), (75, 58, 20), 1)
        return bg


def put(img, text, x, y, color=C_WHITE, scale=0.42, thick=1):
    cv2.putText(img, text, (int(x), int(y)), cv2.FONT_HERSHEY_SIMPLEX, scale, color, thick, cv2.LINE_AA)


def panel(img, x0, y0, x1, y1, title=None, accent=C_CYAN):
    img[y0:y1, x0:x1] = cv2.convertScaleAbs(img[y0:y1, x0:x1], alpha=0.30)
    cv2.rectangle(img, (x0, y0), (x1, y1), C_EDGE, 1)
    for cx, cy, dx, dy in ((x0, y0, 1, 1), (x1, y0, -1, 1), (x0, y1, 1, -1), (x1, y1, -1, -1)):
        cv2.line(img, (cx, cy), (cx + dx * 14, cy), accent, 2, cv2.LINE_AA)
        cv2.line(img, (cx, cy), (cx, cy + dy * 14), accent, 2, cv2.LINE_AA)
    if title:
        put(img, title, x0 + 12, y0 + 22, accent, 0.45)
        cv2.line(img, (x0 + 10, y0 + 30), (x1 - 10, y0 + 30), C_EDGE, 1)


