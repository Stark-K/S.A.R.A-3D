def ensure_model():
    if os.path.exists(MODEL_PATH):
        return
    print("Downloading hand landmark model (one time only)...")
    try:
        urllib.request.urlretrieve(MODEL_URL, MODEL_PATH)
    except Exception as error:
        if os.path.exists(MODEL_PATH):
            os.remove(MODEL_PATH)
        raise RuntimeError(f"Could not download the model: {error}\nDownload {MODEL_URL}\nand save it as {MODEL_PATH}")


def open_camera():
    cap = cv2.VideoCapture(CAMERA_INDEX, cv2.CAP_DSHOW) if os.name == "nt" else cv2.VideoCapture(CAMERA_INDEX)
    if not cap.isOpened():
        cap = cv2.VideoCapture(CAMERA_INDEX)
    if not cap.isOpened():
        raise RuntimeError("Could not open the camera. Close other apps using it.")
    cap.set(cv2.CAP_PROP_FOURCC, cv2.VideoWriter_fourcc(*"MJPG"))
    cap.set(cv2.CAP_PROP_FRAME_WIDTH, W)
    cap.set(cv2.CAP_PROP_FRAME_HEIGHT, H)
    cap.set(cv2.CAP_PROP_BUFFERSIZE, 1)
    return cap


def fit_frame(img):
    h, w = img.shape[:2]
    target = W / H
    if w / h > target + 1e-3:
        nw = int(h * target)
        x0 = (w - nw) // 2
        img = img[:, x0:x0 + nw]
    elif w / h < target - 1e-3:
        nh = int(w / target)
        y0 = (h - nh) // 2
        img = img[y0:y0 + nh]
    if img.shape[1] != W or img.shape[0] != H:
        img = cv2.resize(img, (W, H), interpolation=cv2.INTER_LINEAR)
    return img


class HandTracker(threading.Thread):
    """Camera + MediaPipe in a background thread so rendering stays smooth."""

    def __init__(self):
        super().__init__(daemon=True)
        self.cap = open_camera()
        self.landmarker = vision.HandLandmarker.create_from_options(
            vision.HandLandmarkerOptions(
                base_options=mp_tasks.BaseOptions(model_asset_path=MODEL_PATH),
                running_mode=vision.RunningMode.VIDEO, num_hands=2,
                min_hand_detection_confidence=0.6, min_hand_presence_confidence=0.5,
                min_tracking_confidence=0.5))
        self.cond = threading.Condition()
        self.frame_id, self.frame, self.hands = 0, None, []
        self.running = True

    def run(self):
        t0, last_ts = time.monotonic(), -1
        while self.running:
            ok, raw = self.cap.read()
            if not ok:
                time.sleep(0.01)
                continue
            frame = cv2.flip(fit_frame(raw), 1)
            small = cv2.cvtColor(cv2.resize(frame, (DET_W, DET_H), interpolation=cv2.INTER_AREA),
                                 cv2.COLOR_BGR2RGB)
            ts = max(last_ts + 1, int((time.monotonic() - t0) * 1000))
            last_ts = ts
            res = self.landmarker.detect_for_video(mp.Image(image_format=mp.ImageFormat.SRGB, data=small), ts)
            hands = []
            for i, lms in enumerate(res.hand_landmarks):
                label = res.handedness[i][0].category_name if res.handedness else str(i)
                hands.append((label, np.array([(p.x * W, p.y * H) for p in lms], np.float32)))
            with self.cond:
                self.frame, self.hands = frame, hands
                self.frame_id += 1
                self.cond.notify_all()

    def get(self, last_id, timeout=0.1):
        with self.cond:
            self.cond.wait_for(lambda: self.frame_id != last_id or not self.running, timeout)
            return self.frame_id, self.frame, self.hands

    def stop(self):
        self.running = False
        self.join(timeout=2)
        self.cap.release()
        self.landmarker.close()


class PinchTracker:
    """Pinch state with hysteresis, smoothing and a smoothed hand size (for depth)."""

    def __init__(self):
        self.state, self.smooth, self.size = {}, {}, {}

    def update(self, hands):
        out, used = [], set()
        for label, pts in hands:
            key = label + "2" if label in used else label
            used.add(key)
            size = float(np.linalg.norm(pts[9] - pts[0])) + 1e-5
            ratio = float(np.linalg.norm(pts[4] - pts[8])) / size
            was = self.state.get(key, False)
            pinching = ratio < (PINCH_OFF if was else PINCH_ON)
            self.state[key] = pinching
            mid = (pts[4] + pts[8]) / 2
            prev = self.smooth.get(key)
            point = mid if (prev is None or not was) else prev * 0.4 + mid * 0.6
            self.smooth[key] = point
            ps = self.size.get(key)
            self.size[key] = size if (ps is None or not was) else ps * 0.7 + size * 0.3
            out.append({"key": key, "pts": [(int(x), int(y)) for x, y in pts], "pinching": pinching,
                        "ratio": ratio, "point": (float(point[0]), float(point[1])), "size": self.size[key]})
        for k in list(self.state):
            if k not in used:
                self.state[k] = False
        return sorted(out, key=lambda h: h["key"])


