def edge_flags(mesh, hide_below_deg):
    """Per-face flags: which of a triangle's 3 edges are drawn as wire lines.
    Edges between nearly-flat neighbours are hidden (0 = show all, >=180 = none)."""
    n = len(mesh.faces)
    if hide_below_deg >= 180:
        return np.zeros((n, 3), np.float32)
    flags = np.ones((n, 3), np.float32)
    if hide_below_deg <= 0 or n == 0 or len(mesh.face_adjacency) == 0:
        return flags
    keep = mesh.face_adjacency_angles < math.radians(hide_below_deg)
    adj, edges = mesh.face_adjacency[keep], mesh.face_adjacency_edges[keep]
    for col in (0, 1):
        f = adj[:, col]
        fv = mesh.faces[f]
        opposite = (fv != edges[:, 0:1]) & (fv != edges[:, 1:2])
        flags[f, opposite.argmax(axis=1)] = 0.0
    return flags


def build_vertex_data(mesh, face_colors, flags):
    faces = len(mesh.faces)
    pos = mesh.triangles.astype(np.float32).reshape(-1, 3)
    nrm = np.repeat(mesh.face_normals.astype(np.float32), 3, axis=0)
    col = np.repeat(face_colors.astype(np.float32), 3, axis=0)
    bary = np.tile(np.eye(3, dtype=np.float32), (faces, 1))
    flg = np.repeat(flags.astype(np.float32), 3, axis=0)
    return np.hstack([pos, nrm, col, bary, flg]).astype(np.float32)


class Geometry:
    """One mesh on the GPU. Vertices live in the owning object's local space."""

    def __init__(self, renderer, mesh, face_colors, flags):
        self.mesh = mesh
        self.face_colors = np.asarray(face_colors, np.float32)
        self.flags = np.asarray(flags, np.float32)
        self._hull = self._facets = None
        data = build_vertex_data(mesh, self.face_colors, self.flags)
        self.vbo = renderer.ctx.buffer(data.tobytes())
        self.vao = renderer.ctx.vertex_array(
            renderer.prog,
            [(self.vbo, "3f 3f 3f 3f 3f", "in_position", "in_normal",
              "in_color", "in_bary", "in_flags")])

    def release(self):
        self.vao.release()
        self.vbo.release()

    @property
    def hull(self):
        """Points whose extremes match the mesh's (used for contact / alignment maths)."""
        if self._hull is None:
            v = np.asarray(self.mesh.vertices, np.float64)
            if len(v) > 3000:
                v = v[:: len(v) // 2000 + 1]
                lo, hi = np.asarray(self.mesh.bounds, np.float64)
                corners = np.array([[x, y, z] for x in (lo[0], hi[0]) for y in (lo[1], hi[1])
                                    for z in (lo[2], hi[2])])
                v = np.vstack([v, corners])
            self._hull = v
        return self._hull

    @property
    def facets(self):
        if self._facets is None:
            try:
                self._facets = compute_facets(self.mesh) if len(self.mesh.faces) <= 60000 else []
            except Exception:
                self._facets = []
        return self._facets


def compute_facets(mesh, min_frac=0.04, max_n=8):
    """Big flat faces of a mesh as {n, c, area} in local space (numpy only)."""
    if len(mesh.faces) == 0:
        return []
    n = np.asarray(mesh.face_normals, np.float64)
    a = np.asarray(mesh.area_faces, np.float64)
    c = np.asarray(mesh.triangles_center, np.float64)
    off = np.einsum("ij,ij->i", n, c)
    key = np.round(np.column_stack([n * 40.0, off * 40.0])).astype(np.int64)
    _, inv = np.unique(key, axis=0, return_inverse=True)
    inv = np.asarray(inv).reshape(-1)
    area = np.bincount(inv, weights=a)
    total = float(area.sum()) or 1.0
    out = []
    for g in np.argsort(area)[::-1][:max_n]:
        if area[g] < min_frac * total:
            break
        sel = inv == g
        w = a[sel]
        nn = (n[sel] * w[:, None]).sum(0)
        nn /= np.linalg.norm(nn) + 1e-12
        out.append({"n": nn, "c": (c[sel] * w[:, None]).sum(0) / w.sum(), "area": float(area[g])})
    return out


def normalized(mesh):
    m = mesh.copy()
    m.apply_translation(-m.bounds.mean(axis=0))
    ext = float(m.extents.max())
    if ext > 0:
        m.apply_scale(1.0 / ext)
    return m


Z_TO_Y = trimesh.transformations.rotation_matrix(-math.pi / 2, [1, 0, 0])


def build_primitive(kind):
    c = trimesh.creation
    if kind == "cube":
        return normalized(c.box(extents=(1, 1, 1))), 20
    if kind == "pyramid":
        m = c.cone(radius=0.7071, height=1.0, sections=4)
        m.apply_transform(Z_TO_Y)
        m.apply_transform(trimesh.transformations.rotation_matrix(math.pi / 4, [0, 1, 0]))   # edges parallel to axes
        return normalized(m), 20
    if kind == "cone":
        m = c.cone(radius=0.5, height=1.0, sections=48)
        m.apply_transform(Z_TO_Y)
        return normalized(m), 25
    if kind == "cylinder":
        m = c.cylinder(radius=0.5, height=1.0, sections=48)
        m.apply_transform(Z_TO_Y)
        return normalized(m), 25
    if kind == "sphere":
        return normalized(c.icosphere(subdivisions=2, radius=0.5)), 0
    if kind == "torus":
        return normalized(c.torus(major_radius=0.36, minor_radius=0.14,
                                  major_sections=36, minor_sections=14)), 0
    raise ValueError(f"unknown shape {kind}")


def mesh_face_colors(mesh):
    try:
        if mesh.visual.kind in ("face", "vertex"):
            return np.asarray(mesh.visual.face_colors, np.float32)[:, :3] / 255.0
    except Exception:
        pass
    return None


def split_into_parts(mesh, base):
    """A single mesh made of separate pieces becomes several parts."""
    if len(mesh.faces) > 300000:
        return [(base, mesh)]
    try:
        comps = mesh.split(only_watertight=False)
    except Exception:
        return [(base, mesh)]
    if len(comps) <= 1:
        return [(base, mesh)]
    comps = sorted(comps, key=lambda c: len(c.faces), reverse=True)
    keep, rest = comps[:MAX_PARTS - 1], comps[MAX_PARTS - 1:]
    out = [(f"Part {i + 1}", c) for i, c in enumerate(keep)]
    if rest:
        out.append(("Small parts", trimesh.util.concatenate(rest)))
    return out


def load_model_parts(path):
    """Load a 3D file as a list of (part name, mesh, colours or None), jointly normalised.
    Scene files (GLB/GLTF/OBJ groups) keep their node names; single meshes are split
    into connected pieces."""
    ext = os.path.splitext(path)[1].lower()
    loaded = trimesh.load(path)
    base = os.path.splitext(os.path.basename(path))[0]
    raw = []
    if isinstance(loaded, trimesh.Scene):
        for node in loaded.graph.nodes_geometry:
            T, gname = loaded.graph[node]
            g = loaded.geometry.get(gname)
            if isinstance(g, trimesh.Trimesh) and len(g.faces):
                m = g.copy()
                m.apply_transform(T)
                raw.append((str(node), m))
        if len(raw) == 1:
            raw = split_into_parts(raw[0][1], raw[0][0])
    elif isinstance(loaded, trimesh.Trimesh) and len(loaded.faces):
        raw = split_into_parts(loaded, base)
    if not raw:
        raise ValueError("no triangle mesh found in that file")

    if len(raw) > MAX_PARTS:
        extra = trimesh.util.concatenate([m for _, m in raw[MAX_PARTS - 1:]])
        raw = raw[:MAX_PARTS - 1] + [("Other parts", extra)]
    seen = {}
    for i, (name, m) in enumerate(raw):                    # unique names
        seen[name] = seen.get(name, 0) + 1
        if seen[name] > 1:
            raw[i] = (f"{name} {seen[name]}", m)
    if ext in (".stl", ".ply", ".off", ".3mf"):            # usually Z-up
        for _, m in raw:
            m.apply_transform(Z_TO_Y)
    if len(raw) == 1 and len(raw[0][1].faces) > MAX_MODEL_FACES:
        try:
            raw[0] = (raw[0][0], raw[0][1].simplify_quadric_decimation(face_count=MAX_MODEL_FACES))
        except Exception:
            pass

    total_faces = sum(len(m.faces) for _, m in raw)
    if total_faces > 600000:
        raise ValueError(f"model too heavy ({total_faces} faces)")
    allv = np.vstack([m.vertices for _, m in raw])
    lo, hi = allv.min(0), allv.max(0)
    center, ext_size = (lo + hi) / 2, float((hi - lo).max())
    out = []
    for name, m in raw:
        colors = mesh_face_colors(m)
        m.apply_translation(-center)
        if ext_size > 0:
            m.apply_scale(1.0 / ext_size)
        out.append((name, m, colors))
    return out


