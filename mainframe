class Spinner:
    """Rotates one or more parts around an axis through a pivot (object-local space)."""

    def __init__(self, pivot, axis, speed=SPIN_SPEED):
        self.pivot = np.asarray(pivot, np.float32)
        self.axis = unit(axis)
        self.speed = float(speed)
        self.angle = 0.0
        self.on = True
        self.engine_driven = False
        self.mat = np.eye(4, dtype=np.float32)

    def advance(self, dt):
        if self.on:
            self.angle = (self.angle + self.speed * dt) % (2 * math.pi)
            self.mat = translate(*self.pivot) @ axis_angle(self.axis, self.angle) @ translate(*(-self.pivot))


class Part:
    def __init__(self, geom, name, color_name="cyan", override=True):
        self.geom, self.name = geom, name
        self.color_name, self.override = color_name, override
        self.spinner = None

    def face_colors(self):
        if self.override:
            return np.tile(np.array(COLORS[self.color_name], np.float32), (len(self.geom.mesh.faces), 1))
        return self.geom.face_colors

    def rgb(self):
        return COLORS[self.color_name] if self.override else (0.7, 0.7, 0.75)


class SceneObject:
    def __init__(self, parts, kind, name, x, y, z=0.0, scale=1.1):
        self.parts, self.kind, self.name = parts, kind, name
        self.focus = None                            # index of the highlighted part
        self.x = self.tx = float(x)
        self.y = self.ty = float(y)
        self.z = self.tz = float(z)
        self.scale = float(scale)
        self.stretch = np.ones(3, np.float32)
        self.ax, self.ay = 0.35, 0.6
        self.style = DEFAULT_STYLE
        self.R0 = np.eye(4, dtype=np.float32)      # orientation set by self-alignment
        self.engine = None
        self.spin, self.spin_speed = False, 1.3
        self.selected = self.held = False
        self.refresh_bounds()

    def refresh_bounds(self):
        lo = np.min([p.geom.mesh.bounds[0] for p in self.parts], axis=0)
        hi = np.max([p.geom.mesh.bounds[1] for p in self.parts], axis=0)
        self.local_bounds = (lo, hi)

    def rot4(self):
        return rot_y(self.ay) @ rot_x(self.ax) @ self.R0

    def model_matrix(self, r, target=False):
        x, y, z = (self.tx, self.ty, self.tz) if target else (self.x, self.y, self.z)
        wx, wy, wz = r.unproject(x, y, z)
        return translate(wx, wy, wz) @ self.rot4() @ scale_m(*(self.stretch * self.scale))

    def part_transform(self, part):
        sp = part.spinner
        return sp.mat if (sp is not None and sp.angle != 0.0) else np.eye(4, dtype=np.float32)

    def radius_px(self, r):
        return max(45.0, 0.58 * r.px_per_world(self.z) * self.scale * float(self.stretch.max()))

    def spinners(self):
        return list({id(p.spinner): p.spinner for p in self.parts if p.spinner}.values())

    def display_rgb(self):
        p = self.parts[self.focus] if self.focus is not None else self.parts[0]
        return p.rgb()


